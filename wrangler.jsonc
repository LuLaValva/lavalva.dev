{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "lavalva-dev",
  "compatibility_date": "2026-09-01",
  "main": "./dist/index.mjs",
  "assets": {
    "directory": "./dist/public",
    "binding": "ASSETS",
  },
  "r2_buckets": [
    {
      "binding": "KBD_TRAINING",
      "bucket_name": "kbd-training",
    },
  ],
  "ratelimits": [
    {
      // A whole evening's sets go up in ten calls: more than that in a minute is no one swiping.
      "name": "KBD_TRAINING_LIMIT",
      "namespace_id": "1001",
      "simple": { "limit": 12, "period": 60 },
    },
  ],
}
