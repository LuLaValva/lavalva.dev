// A <let> whose value lives in the URL search params, one string per key:
// read on mount (`default` wins unless every key is present), written back
// through history.replaceState on assignment. Server render, being
// prerendered, always uses `default`.
export interface Input {
  keys: readonly string[];
  default: string[];
}

<let/value=input.default>

<script>
  const params = new URLSearchParams(location.search);
  const fromUrl = input.keys.map((k) => params.get(k));
  if (fromUrl.every((v) => v !== null)) value = fromUrl as string[];
</script>

<return=value
  valueChange(next: string[]) {
    value = next;
    const params = new URLSearchParams(location.search);
    input.keys.forEach((k, i) => params.set(k, next[i]));
    history.replaceState(null, "", `?${params}${location.hash}`);
  }
>
