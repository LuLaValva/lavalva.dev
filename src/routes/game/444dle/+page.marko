import styles from "./444dle.module.css";
import {
  BULL,
  dailySolutions,
  EMOJIS,
  type Eval,
  evaluate,
  MISS,
  NUM_GUESSES,
  NUM_LETTERS,
  NUM_WORDS,
  requestDay,
  SOLVED_EMOJI,
} from "./utils";

client const vibrate = (pattern: number | number[]) =>
  navigator.vibrate?.(pattern);

<lazy-word-list/validWords/>

<const/day=requestDay($global.request)>
<const/today=day.toLocaleDateString("en-US", {
  month: "numeric",
  day: "numeric",
  year: "2-digit",
})>
<const/solutions=dailySolutions(day)>

<let/guesses=[] as string[]>
<let/pending="">
<let/invalid=false>

<const/boards=solutions.map((solution) => {
  const rows = guesses.map((guess) => ({
    guess,
    scores: evaluate(guess, solution),
  }));
  const wonAt = rows.findIndex(({ scores }) =>
    scores.every((score) => score === BULL),
  );
  return {
    solution,
    wonAt: wonAt === -1 ? undefined : wonAt,
    played: wonAt === -1 ? rows : rows.slice(0, wonAt + 1),
  };
})>

<const/won=boards.every(({ wonAt }) => wonAt !== undefined)>
<const/finished=won || guesses.length >= NUM_GUESSES>

<const/keyColors=Object.fromEntries(
  [...new Set(guesses.join(""))].map((letter) => [
    letter,
    boards.map(({ played }) =>
      played
        .flatMap(({ guess, scores }) =>
          scores.filter((_, i) => guess[i] === letter),
        )
        .reduce<Eval>((best, score) => (score > best ? score : best), MISS),
    ),
  ]),
)>

<const/score=(
  boards
    .map(({ wonAt }) => (wonAt === undefined ? Infinity : wonAt + 1))
    .sort((a, b) => b - a)
    .map((count) => (count === Infinity ? "X" : count))
    .join("")
)>

<const/block(indexes: number[], indent = "") {
  const group = indexes.map((i) => boards[i]);
  const height = Math.max(...group.map(({ played }) => played.length));
  return Array.from(
    { length: height },
    (_, row) =>
      indent +
      group
        .map(
          ({ played }) =>
            played[row]?.scores.map((score) => EMOJIS[score]).join("") ??
            SOLVED_EMOJI.repeat(NUM_LETTERS),
        )
        .join("  "),
  ).join("\n");
}>

// The indent was set by eye against how imessage lays emoji out.
<const/summary=(
  `444dle ${today}: ${score}

${block([0, 1])}

${block([2], "            ")}`
)>

<const/submit() {
  if (!validWords || pending.length < NUM_LETTERS) return;
  if (!validWords.includes(pending)) {
    invalid = true;
    vibrate([100, 100, 50, 100, 100]);
    setTimeout(() => (invalid = false), 600);
    return;
  }
  // Asked of `next` rather than read off `finished`, which still describes the
  // guess before this one until the render queue flushes.
  const next = [...guesses, pending];
  const over =
    next.length >= NUM_GUESSES ||
    solutions.every((solution) => next.includes(solution));
  guesses = next;
  pending = "";
  vibrate(50);
  if (over) {
    // 300ms is the per-column stagger in the stylesheet; the rest is one turn
    // plus a beat, so the results do not cut the reveal off.
    setTimeout(() => results().showModal(), (NUM_LETTERS - 1) * 300 + 800);
  }
}>

<const/type(key: string) {
  if (finished) return;
  if (key === "Enter") {
    submit();
  } else if (key === "Backspace" || key === "Delete") {
    invalid = false;
    pending = pending.slice(0, -1);
  } else if (/^[a-zA-Z]$/.test(key) && pending.length < NUM_LETTERS) {
    invalid = false;
    pending += key.toLowerCase();
  }
}>

<header class=styles.header>
  <h1>444dle</h1>
  <span class=styles.headerActions>
    <button
      class=styles.btn
      title="help"
      onclick="this.nextElementSibling.showModal()"
    >
      ?
    </button>
    <dialog closedby="any">
      <div class=styles.dialogHeading>
        <h3>Three words, one keyboard</h3>
        <form method="dialog">
          <button class=styles.btn aria-label="close dialog">×</button>
        </form>
      </div>
      <p>Every guess is played against all three words at once.</p>
      <p>
        <strong class=styles.eval2>Green</strong> is the right letter in the
        right spot, <strong class=styles.eval1>orange</strong> is the right
        letter somewhere else, grey is not in the word at all.
      </p>
      <p>A key is striped with its colour for each word, in order.</p>
      <p>You get ${NUM_GUESSES} guesses for all ${NUM_WORDS} words.</p>
    </dialog>
    <if=finished>
      <button
        class=styles.btn
        title="show results"
        onClick() {
          results().showModal();
        }
      >
        ⇪
      </button>
    </if>
  </span>
</header>

<div class=styles.boards>
  <for|{ played, wonAt }, i| of=boards>
    <board
      index=i
      played=played
      pending=wonAt === undefined ? pending : ""
      pendingAt=guesses.length
      invalid=invalid
    />
  </for>
</div>

<keyboard keyColors=keyColors onKey=type/>

<dialog/results class=styles.results closedby="any">
  <div class=styles.dialogHeading>
    <h3>${won ? "you win!" : "you are awful at this."}</h3>
    <form method="dialog">
      <button class=styles.btn aria-label="close dialog">×</button>
    </form>
  </div>
  <p class=styles.score>${score}</p>
  <p class=styles.answers>
    <for|{ solution }| of=boards><em>${solution}</em></for>
  </p>
  <hr>
  <button
    class=styles.share
    onClick() {
      const text = `${summary}\n\n${location.origin}${location.pathname}`;
      if (navigator.share) {
        navigator.share({ text });
      } else if (navigator.clipboard) {
        navigator.clipboard.writeText(text).then(() => {
          alert("Copied to clipboard!");
        });
      }
    }
  >
    Share with Friends
  </button>
</dialog>

<script>
  document.addEventListener(
    "keydown",
    (e) => {
      if (e.altKey || e.ctrlKey || e.metaKey) return;
      if (!/^(Enter|Backspace|[a-zA-Z])$/.test(e.key)) return;
      if (document.querySelector("dialog[open]")) return;
      e.preventDefault();
      type(e.key);
    },
    { signal: $signal },
  );
</script>
