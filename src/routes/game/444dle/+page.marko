import styles from "./444dle.module.css";
import {
  BULL,
  binarySearch,
  dailySolutions,
  EMOJIS,
  type Eval,
  evaluate,
  MISS,
  NUM_GUESSES,
  NUM_LETTERS,
  NUM_WORDS,
  requestDay,
  SOLVED_EMOJI,
} from "./utils";

client {
  const vibrate =
    typeof navigator.vibrate === "function"
      ? (pattern: number | number[]) => navigator.vibrate(pattern)
      : () => {};
}

<lazy-word-list/validWords/>

<const/day=requestDay($global.request)>
<const/today=day.toLocaleDateString("en-US", {
  month: "numeric",
  day: "numeric",
  year: "2-digit",
})>
<const/solutions=dailySolutions(day)>

<let/guesses=[] as string[]>
<let/pending="">
<let/invalid=false>

// Every board is derived from the guess list, so a guess only has to be
// recorded once. Everything else derives from `boards` rather than reaching
// back to `guesses`, which keeps the derivations in one ordered chain.
<const/boards=solutions.map((solution) => {
  const rows = guesses.map((guess) => ({
    guess,
    scores: evaluate(guess, solution),
  }));
  const wonAt = rows.findIndex(({ scores }) =>
    scores.every((score) => score === BULL),
  );
  return { solution, rows, wonAt: wonAt === -1 ? undefined : wonAt };
})>

<const/won=boards.every(({ wonAt }) => wonAt !== undefined)>
<const/finished=won || guesses.length >= NUM_GUESSES>

<const/keyColors=boards.reduce(
  (colors, { rows, wonAt }, board) => {
    rows.forEach(({ guess, scores }, row) => {
      // A solved board stops tinting keys.
      if (wonAt !== undefined && wonAt < row) return;
      scores.forEach((score, i) => {
        const letter = guess[i];
        const seen = (colors[letter] ??= Array(NUM_WORDS).fill(MISS) as Eval[]);
        if (score > seen[board]) seen[board] = score;
      });
    });
    return colors;
  },
  {} as Record<string, Eval[]>,
)>

// One digit per board, worst first: the word that held out longest leads.
// A board never solved has no digit to give and sorts ahead of all of them.
<const/score=(
  boards
    .map(({ wonAt }) => (wonAt === undefined ? null : wonAt + 1))
    .sort((a, b) => (a === null ? -1 : b === null ? 1 : b - a))
    .map((guesses) => guesses ?? "X")
    .join("")
)>

// Boards one and two side by side and the third below them, rather than three
// across: four emoji is wide, and three of those does not survive a narrow
// window. The third is indented to sit under the second. Each block runs only
// as far as its own boards needed, so nothing trails a row of blanks.
<const/block(indexes: number[], indent = "") {
  const until = Math.max(
    ...indexes.map((i) =>
      boards[i].wonAt === undefined ? guesses.length - 1 : boards[i].wonAt,
    ),
  );
  return boards[0].rows
    .slice(0, until + 1)
    .map(
      (_, row) =>
        indent +
        indexes
          .map((i) => {
            const { rows, wonAt } = boards[i];
            return wonAt !== undefined && wonAt < row
              ? SOLVED_EMOJI.repeat(NUM_LETTERS)
              : rows[row].scores.map((score) => EMOJIS[score]).join("");
          })
          .join("  "),
    )
    .join("\n");
}>

<const/summary=(
  `444dle ${today}: ${score}

${block([0, 1])}

${block([2], "          ")}`
)>

<const/submit() {
  if (!validWords || pending.length < NUM_LETTERS) return;
  if (!binarySearch(validWords, pending)) {
    invalid = true;
    vibrate([100, 100, 50, 100, 100]);
    setTimeout(() => (invalid = false), 600);
    return;
  }
  const next = [...guesses, pending];
  const over =
    next.length >= NUM_GUESSES ||
    solutions.every((solution) => next.includes(solution));
  guesses = next;
  pending = "";
  vibrate(50);
  // Let the reveal animation finish before the results take over the screen.
  if (over) {
    setTimeout(() => results().showModal(), (NUM_LETTERS - 1) * 300 + 800);
  }
}>

<const/type(key: string) {
  if (finished) return;
  if (key === "Enter") {
    submit();
  } else if (key === "Backspace" || key === "Delete") {
    invalid = false;
    pending = pending.slice(0, -1);
  } else if (/^[a-zA-Z]$/.test(key) && pending.length < NUM_LETTERS) {
    invalid = false;
    pending += key.toLowerCase();
  }
}>

<header class=styles.header>
  <h1>444dle</h1>
  <span class=styles.headerActions>
    <button
      class=styles.btn
      title="help"
      onclick="this.nextElementSibling.showModal()"
    >
      ?
    </button>
    <dialog closedby="any">
      <div class=styles.dialogHeading>
        <h3>Three words, one keyboard</h3>
        <form method="dialog">
          <button class=styles.btn aria-label="close dialog">×</button>
        </form>
      </div>
      <p>Every guess is played against all three words at once.</p>
      <p>
        <strong class=styles.eval2>Green</strong> is the right letter in the
        right spot, <strong class=styles.eval1>orange</strong> is the right
        letter somewhere else.
      </p>
      <p>You get ${NUM_GUESSES} guesses for all ${NUM_WORDS} words.</p>
    </dialog>
    <if=finished>
      <button
        class=styles.btn
        title="show results"
        onClick() {
          results().showModal();
        }
      >
        ⇪
      </button>
    </if>
  </span>
</header>

<div class=styles.boards>
  <for|{ rows, wonAt }, i| of=boards>
    <board index=i rows=rows pending=pending wonAt=wonAt invalid=invalid/>
  </for>
</div>

<keyboard keyColors=keyColors onKey=type/>

<dialog/results class=styles.results closedby="any">
  <div class=styles.dialogHeading>
    <h3>${won ? "you win!" : "you are awful at this."}</h3>
    <form method="dialog">
      <button class=styles.btn aria-label="close dialog">×</button>
    </form>
  </div>
  <p class=styles.score>${score}</p>
  <p class=styles.answers>
    <for|{ solution }| of=boards><em>${solution}</em></for>
  </p>
  <hr>
  <pre>${summary}</pre>
  <hr>
  <button
    class=styles.share
    onClick() {
      if (navigator.share) {
        navigator.share({ text: summary });
      } else if (navigator.clipboard) {
        navigator.clipboard.writeText(summary).then(() => {
          alert("Copied to clipboard!");
        });
      }
    }
  >
    Share with Friends
  </button>
</dialog>

<script>
  document.addEventListener(
    "keydown",
    (e) => {
      if (e.altKey || e.ctrlKey || e.metaKey) return;
      if (
        e.key === "Enter" ||
        e.key === "Backspace" ||
        /^[a-zA-Z]$/.test(e.key)
      ) {
        if (document.querySelector("dialog[open]")) return;
        e.preventDefault();
        type(e.key);
      }
    },
    { signal: $signal },
  );
</script>
