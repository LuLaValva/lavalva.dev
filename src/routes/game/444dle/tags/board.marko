import { type Eval, NUM_GUESSES, NUM_LETTERS } from "../utils";
import styles from "../444dle.module.css";

// Slices through the tile's thickness. Enough that neighbouring slices still
// overlap on screen at a steep angle, which is what keeps the side reading as
// solid rather than as a staircase.
static const SLICES = 12;
// Spaced around a half turn rather than evenly through the depth, so the
// slices sit at even steps along the bevel's curve. Stepping z evenly instead
// would bunch them at the middle and leave a jump at either face, where the
// curve is steepest.
static const BODY = Array.from({ length: SLICES }, (_, i) => {
  const angle = Math.PI * (i / (SLICES - 1) - 0.5);
  return {
    // Just shy of the faces, so the outermost slices do not fight them.
    z: Math.sin(angle) * 0.98,
    // How far this slice stands out from the tile's edge: none at the faces,
    // most at mid depth. A slice at the surface is therefore exactly the flat
    // tile, which is what keeps the two renderings interchangeable.
    out: Math.cos(angle).toFixed(4),
    mix: `${Math.round((Math.sin(angle) + 1) * 50)}%`,
  };
});

export interface Input {
  /** Which of the three boards this is; varies the tile tilt between them. */
  index: number;
  /** Each submitted guess with its score against this board's solution. */
  rows: { guess: string; scores: Eval[] }[];
  /** The guess currently being typed. */
  pending: string;
  /** Index of the guess that solved this board, if any. */
  wonAt?: number;
  /** Set while the pending guess is being rejected, to shake the row. */
  invalid?: boolean;
}

<const/cells=Array.from({ length: NUM_GUESSES }, (_, i) => {
  // Once solved, a board stops echoing later guesses.
  if (input.wonAt !== undefined && i > input.wonAt) return {};
  const row = input.rows[i];
  if (row) {
    return {
      word: row.guess,
      evaluation: row.scores,
      // Only the newest row still has a turn to play out.
      flipping: i === input.rows.length - 1,
    };
  }
  if (i === input.rows.length) return { word: input.pending };
  return {};
})>

// A hash rather than Math.random, so a tile keeps its tilt across renders and
// the server and client agree on it. `settled` picks a second, unrelated
// angle: a tile that has been turned over has been disturbed, and lands at a
// different lie than it was sitting at.
<const/tilt(row: number, column: number, settled: number) {
  const n =
    Math.sin(
      input.index * 12.9898 + row * 78.233 + column * 37.719 + settled * 55.137,
    ) * 43758.5;
  return (n - Math.floor(n) - 0.5) * 4;
}>

<div class=[styles.board, input.wonAt !== undefined && styles.solved]>
  <for|{ word = "", evaluation, flipping }, row| of=cells>
    <div class=[
      styles.row,
      input.invalid && row === input.rows.length && styles.invalid,
    ]>
      <for|_, i| of=Array.from({ length: NUM_LETTERS })>
        <div
          class=[
            styles.cell,
            evaluation
              ? [
                  styles.scored,
                  styles[`eval${evaluation[i]}`],
                  flipping && styles.flipping,
                ]
              : word[i] && styles.filled,
          ]
          style=`--i:${i}; --lie:${tilt(row, i, 0)}deg; --lie-settled:${tilt(row, i, 1)}deg`
          data-letter=word[i]?.toUpperCase()
        >
          <if=flipping>
            <for|{ z, out, mix }| of=BODY>
              <span
                class=styles.slice
                style=`--z:${z}; --out:${out}; --mix:${mix}`
              />
            </for>
          </if>
          ${word[i]?.toUpperCase()}
        </div>
      </for>
    </div>
  </for>
</div>
