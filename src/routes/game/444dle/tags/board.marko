import { COLORS, type Eval, NUM_GUESSES, NUM_LETTERS } from "../utils";
import styles from "../444dle.module.css";

static const COLUMNS = Array.from({ length: NUM_LETTERS }, (_, i) => i);

// Slices spaced around a half turn rather than evenly through the depth, so
// they sit at even steps along the bevel's curve. Twelve keeps neighbours
// overlapping on screen at a steep angle, which reads as solid rather than as
// a staircase.
static const SLICES = 12;
static const BODY = Array.from({ length: SLICES }, (_, i) => {
  const angle = Math.PI * (i / (SLICES - 1) - 0.5);
  return {
    z: Math.sin(angle) * 0.98,
    out: Math.cos(angle).toFixed(4),
    mix: `${Math.round((Math.sin(angle) + 1) * 50)}%`,
  };
});

export interface Input {
  index: number;
  /** The guesses this board is still answering, oldest first. */
  rows: { guess: string; scores: Eval[] }[];
  pending: string;
  pendingAt: number;
  invalid?: boolean;
}

<const/cells=Array.from({ length: NUM_GUESSES }, (_, i) => {
  const row = input.rows[i];
  if (!row) return { word: i === input.pendingAt ? input.pending : "" };
  return {
    word: row.guess,
    evaluation: row.scores,
    flipping: i === input.pendingAt - 1,
  };
})>

// A hash rather than Math.random, so a tile keeps its tilt across renders and
// the server and client agree on it. A turned tile has been disturbed, so
// `settled` picks a second, unrelated angle for it to land at.
<const/tilt(row: number, column: number, settled: number) {
  const n =
    Math.sin(
      input.index * 12.9898 + row * 78.233 + column * 37.719 + settled * 55.137,
    ) * 43758.5;
  return (n - Math.floor(n) - 0.5) * 4;
}>

// Perspective flattens the hop itself to about a pixel, so it only reads on a
// tile that visibly turns as it comes to rest.
static const SKID_WORTH_A_HOP = 1.5;

<const/bounces(row: number, column: number) {
  return (
    Math.abs(tilt(row, column, 1) - tilt(row, column, 0)) > SKID_WORTH_A_HOP
  );
}>

<div class=styles.board>
  <span class=styles.srOnly>word ${input.index + 1}</span>
  <for|{ word, evaluation, flipping }, row| of=cells>
    <div class=[
      styles.row,
      input.invalid && row === input.pendingAt && styles.invalid,
    ]>
      <for|i| of=COLUMNS>
        <div
          class=[
            styles.cell,
            evaluation
              ? [
                  styles.scored,
                  styles[`eval${evaluation[i]}`],
                  flipping && styles.flipping,
                  flipping && bounces(row, i) && styles.bounces,
                ]
              : word[i] && styles.filled,
          ]
          style=`--i:${i}; --lie:${tilt(row, i, 0)}deg; --lie-settled:${tilt(row, i, 1)}deg`
          data-letter=word[i]
        >
          <if=flipping>
            <for|{ z, out, mix }| of=BODY>
              <span
                class=styles.slice
                style=`--z:${z}; --out:${out}; --mix:${mix}`
              />
            </for>
          </if>
          ${word[i]}
          <if=evaluation>
            <span class=styles.srOnly>${`, ${COLORS[evaluation[i]]}`}</span>
          </if>
        </div>
      </for>
    </div>
  </for>
</div>
