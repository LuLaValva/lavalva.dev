import { type Eval, NUM_WORDS } from "../utils";
import styles from "../444dle.module.css";

export interface Input {
  /** Best score seen for each letter, one entry per board. */
  keyColors: Record<string, Eval[]>;
  onKey: (key: string) => void;
}

static const ROWS = ["qwertyuiop", "asdfghjkl", "zxcvbnm"];

// One hard-edged stripe per board, so a key carries all three verdicts at once.
<const/background(letter: string) {
  const colors = input.keyColors[letter];
  if (!colors) return false;
  const width = 100 / NUM_WORDS;
  const stops = colors.map(
    (score, i) => `var(--eval-${score}) ${width * i}% ${width * (i + 1)}%`,
  );
  return `background-image:linear-gradient(to right, ${stops.join(",")})`;
}>

<div class=styles.keyboard>
  <for|letters, row| of=ROWS>
    <div class=styles.keyboardRow>
      <if=row === 2>
        <button
          class=[styles.key, styles.wideKey]
          onClick() {
            input.onKey("Enter");
          }
        >
          enter
        </button>
      </if>
      <for|letter| of=letters>
        <button
          class=[styles.key, input.keyColors[letter] && styles.tinted]
          style=background(letter)
          onClick() {
            input.onKey(letter);
          }
        >
          ${letter}
        </button>
      </for>
      <if=row === 2>
        <button
          class=[styles.key, styles.wideKey, styles.glyphKey]
          aria-label="delete"
          onClick() {
            input.onKey("Backspace");
          }
        >
          ⌫
        </button>
      </if>
    </div>
  </for>
</div>
