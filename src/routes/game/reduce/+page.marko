import styles from "./reduce.module.css";
import { binarySearch, dailyLetters } from "./utils";
import { requestDay, vibrate } from "../utils";
static interface Letter {
  char: string;
  id: number;
}

<lazy-english-dictionary/words/>

<const/day=requestDay($global.request)>
<const/today=day.toLocaleDateString("en-US", {
  month: "numeric",
  day: "numeric",
  year: "2-digit",
  timeZone: "UTC",
})>
<const/fullDate=day.toLocaleDateString("en-US", {
  dateStyle: "long",
  timeZone: "UTC",
})>

<let/looseLetters=dailyLetters(day, 20).map((char, id) => ({
  char,
  id,
})) as (Letter | null)[]>

<let/pendingWord=[] as Letter[]>
<let/submittedWords=[] as Letter[][]>

<let/incorrectGuess=false>

<script>if (incorrectGuess) vibrate([100, 100, 50, 100, 100]);</script>

<const/points=(
  looseLetters.filter(Boolean).length +
  (pendingWord.length && 1) +
  submittedWords.length
)>

<const/addLetter(i: number) {
  if (!looseLetters[i]) {
    throw new Error("Something broke! Attempted to add invalid letter");
  }
  pendingWord = [...pendingWord, looseLetters[i]];
  looseLetters = looseLetters.toSpliced(i, 1, null);
  incorrectGuess = false;
  vibrate(50);
}>

<const/revertLetters(word: Letter[], clearPrevious: () => void) {
  const nextLetters = [...looseLetters];
  let i = 0;
  for (const letter of word) {
    while (nextLetters[i]) i++;
    nextLetters[i++] = letter;
  }
  document.startViewTransition(() => {
    looseLetters = nextLetters;
    clearPrevious();
    incorrectGuess = false;
  });
  (document.activeElement as HTMLButtonElement)?.blur?.();
}>

<const/submitWord() {
  if (words) {
    if (binarySearch(words, pendingWord.map(({ char }) => char).join(""))) {
      document.startViewTransition(() => {
        submittedWords = [...submittedWords, pendingWord];
        pendingWord = [];
        vibrate(50);
      });
    } else {
      incorrectGuess = true;
    }
  }
}>

<let/helpOpen=false>
<let/resultsOpen=false>

<header class=styles.header>
  <button
    class=styles.btn
    title="help"
    onClick() {
      helpOpen = true;
    }
  >
    ?
  </button>
  <strong>${points}<span class=styles.srOnly>${" "}points</span></strong>
  <button
    class=styles.btn
    title="shuffle loose letters"
    onClick() {
      document.startViewTransition(() => {
        looseLetters = looseLetters.toSorted(() => Math.random() - 0.5);
      });
    }
  >
    ⇆
  </button>
</header>

<game-dialog open:=helpOpen>
  <@heading>Welcome to Reduce!</@heading>
  <p>Match letters to make words</p>
  <p>Every word and loose letter counts as a point</p>
  <p>Your goal is to <em>minimize</em> points</p>
</game-dialog>

<div class=styles.looseLetters>
  <for|letter, i| of=looseLetters>
    <if=letter>
      <button
        class=styles.tile
        onClick() {
          addLetter(i);
        }
        style={
          "view-transition-name": `letter-${letter.id}`,
          rotate: `${(Math.random() - 0.5) * 5}deg`,
        }
      >
        ${letter.char}
      </button>
    </if>
    <else><span/></else>
  </for>
  <button
    class=[styles.btn, styles.openSubmit]
    hidden=looseLetters.some(Boolean)
    title="share score"
    onClick() {
      submitWord();
      resultsOpen = true;
    }
  >
    ⇪
  </button>
</div>

<div class=styles.pendingWord>
  <if=pendingWord.length>
    <button
      class=[styles.pendingLetters, incorrectGuess && styles.incorrectGuess]
      onClick() {
        revertLetters(pendingWord, () => (pendingWord = []));
      }
    >
      <for|letter| of=pendingWord>
        <span
          class=styles.tile
          style={
            "view-transition-name": `letter-${letter.id}`,
            rotate: `${(Math.random() - 0.5) * 2}deg`,
          }
        >
          ${letter.char}
        </span>
      </for>
    </button>
    <span class=styles.actions>
      <button
        class=styles.btn
        aria-label="delete last letter"
        onClick() {
          revertLetters(
            [pendingWord.at(-1)!],
            () => (pendingWord = pendingWord.toSpliced(-1)),
          );
        }
      >
        ⌫
      </button>
      <button
        class=styles.btn
        aria-label="submit"
        disabled=!words
        onClick() {
          submitWord();
        }
      >
        ⏎
      </button>
    </span>
  </if>
</div>

<div class=styles.words>
  <for|word, i| of=submittedWords>
    <button onClick() {
      revertLetters(
        word,
        () => (submittedWords = submittedWords.toSpliced(i, 1)),
      );
    }>
      <for|letter| of=word>
        <span
          class=styles.tile
          style={
            "view-transition-name": `letter-${letter.id}`,
            rotate: `${(Math.random() - 0.5) * 3}deg`,
          }
        >
          ${letter.char}
        </span>
      </for>
    </button>
  </for>
</div>

<const/loose=[
  ...looseLetters.filter((letter) => letter !== null),
  ...pendingWord,
]>
<const/score=submittedWords.length + loose.length>

<game-dialog open:=resultsOpen>
  <@heading>${fullDate}</@heading>
  <p class=styles.stat>${score}</p>
  <p class=styles.caption>${score === 1 ? "point" : "points"}</p>

  <div class=styles.receipt>
    <for|word| of=submittedWords>
      <div class=styles.receiptWord>
        <for|letter| of=word><span class=styles.tile>${letter.char}</span></for>
      </div>
    </for>
    <for|letter| of=loose>
      <div class=[styles.receiptWord, styles.loose]>
        <span class=styles.tile>${letter.char}</span>
      </div>
    </for>
  </div>

  <share-button text=(
    `Reduce ${today}: ${score} ${score === 1 ? "point" : "points"}

${[
  ...submittedWords.map((word) => "🟫".repeat(word.length)),
  ...loose.map(() => "⬜"),
].join("\n")}`
  )/>
</game-dialog>

<script>
  document.addEventListener(
    "keydown",
    (e) => {
      const { key } = e;
      if (/[a-zA-Z]/.test(key) && !e.altKey && !e.ctrlKey && !e.metaKey) {
        const char = key.toLowerCase();
        const i = looseLetters.findIndex((letter) => letter?.char === char);
        if (i >= 0) {
          addLetter(i);
        }
      }
      switch (key) {
        case "Enter":
          if (pendingWord.length) {
            e.preventDefault();
            submitWord();
          }
          break;
        case "Escape":
          e.preventDefault();
          revertLetters(pendingWord, () => (pendingWord = []));
          break;
        case "Backspace":
          if (pendingWord.length) {
            if (e.altKey) {
              revertLetters(pendingWord, () => (pendingWord = []));
            } else {
              revertLetters(
                [pendingWord.at(-1)!],
                () => (pendingWord = pendingWord.toSpliced(-1)),
              );
            }
          }
          break;
      }
    },
    {
      signal: $signal,
    },
  );
</script>
