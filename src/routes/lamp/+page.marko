import styles from "./lamp.module.css";
import {
  Lamp,
  SERVICE,
  CHARACTERISTIC,
  rgbCommand,
  powerCommand,
  hexToRgb,
  parseHex,
  parseUuid,
  toHex,
  supported,
} from "./ble";
import type { ServiceInfo } from "./ble";

static interface LogEntry {
  msg: string;
  kind: "info" | "ok" | "err";
}

<let/ok=true>
<let/lamp=(null as Lamp | null)>
<let/connecting=false>
<let/color="#ff8800">
<let/services=([] as ServiceInfo[])>
<let/rawService="0xffe9">
<let/rawChar="0xffe9">
<let/rawBytes="56 FF 00 00 00 F0 AA">
<let/logs=([] as LogEntry[])>

<const/connected=(lamp !== null)>

<script>
  ok = supported();
</script>

<const/log(msg: string, kind: LogEntry["kind"] = "info") {
  logs = [...logs.slice(-49), { msg, kind }];
}>

<const/run(label: string, work: () => Promise<unknown>) {
  work()
    .then((r) => log(typeof r === "string" ? r : label, "ok"))
    .catch((e: unknown) => log(e instanceof Error ? e.message : String(e), "err"));
}>

<const/connect() {
  if (connecting) return;
  connecting = true;
  Lamp.connect()
    .then((l) => {
      lamp = l;
      log(`Connected to ${l.name}`, "ok");
      l.onDisconnect(() => {
        lamp = null;
        services = [];
        log("Device disconnected", "err");
      });
    })
    .catch((e: unknown) => log(e instanceof Error ? e.message : String(e), "err"))
    .finally(() => (connecting = false));
}>

<const/applyColor() {
  const l = lamp;
  if (!l) return;
  const [r, g, b] = hexToRgb(color);
  run(`color → ${toHex(rgbCommand(r, g, b))}`, () => l.write(SERVICE, CHARACTERISTIC, rgbCommand(r, g, b)));
}>

<const/sendRaw() {
  const l = lamp;
  if (!l) return;
  let bytes: number[];
  try {
    bytes = parseHex(rawBytes);
  } catch (e: unknown) {
    log(e instanceof Error ? e.message : String(e), "err");
    return;
  }
  run(`raw → ${toHex(bytes)}`, () => l.write(parseUuid(rawService), parseUuid(rawChar), bytes));
}>

<div class=styles.page>
  <div class=styles.shell>
    <header>
      <h1>🔦 Bluetooth Lamp</h1>
      <p class=styles.muted>
        Take over a generic BLE lamp — the kind the <em>Colorful Light</em> app
        drives — from the browser with the Web Bluetooth API.
      </p>
    </header>

    <if=!ok>
      <div class=[styles.panel, styles.warn]>
        Web Bluetooth needs a Chromium browser (Chrome, Edge, Opera) over HTTPS
        or localhost. It isn't available here.
      </div>
    </if>

    <section class=styles.panel>
      <div class=styles.spread>
        <span>
          <if=connected>🟢 ${lamp?.name}</if>
          <else>⚪ Not connected</else>
        </span>
        <span class=styles.row>
          <if=!connected>
            <button class=styles.primary disabled=(!ok || connecting) onClick() { connect(); }>
              ${connecting ? "Connecting…" : "Connect"}
            </button>
          </if>
          <else>
            <button onClick() { run("Inspected", () => lamp!.inspect().then((s) => { services = s; return `Found ${s.length} services`; })); }>
              Inspect
            </button>
            <button onClick() { lamp?.disconnect(); lamp = null; services = []; }>Disconnect</button>
          </else>
        </span>
      </div>
    </section>

    <section class=styles.panel>
      <h2>Color &amp; power</h2>
      <p class=styles.muted>Uses the Triones protocol (0xFFE5 / 0xFFE9) — the most common one.</p>
      <div class=styles.row>
        <input type="color" value=color onInput(e) { color = (e.target as HTMLInputElement).value; }>
        <button class=styles.primary disabled=!connected onClick() { applyColor(); }>Apply</button>
        <button disabled=!connected onClick() { run("Power on", () => lamp!.write(SERVICE, CHARACTERISTIC, powerCommand(true))); }>On</button>
        <button disabled=!connected onClick() { run("Power off", () => lamp!.write(SERVICE, CHARACTERISTIC, powerCommand(false))); }>Off</button>
      </div>
    </section>

    <if=services.length>
      <section class=styles.panel>
        <h2>Services</h2>
        <p class=styles.muted>Find a characteristic marked <b>write</b> — that's the command target.</p>
        <for|svc| of=services>
          <div class=styles.svc>
            <div class=styles.mono>${svc.uuid}</div>
            <for|c| of=svc.chars>
              <div class=[styles.mono, styles.char]>
                ${c.uuid} <if=c.write><span class=styles.tag>write</span></if>
              </div>
            </for>
          </div>
        </for>
      </section>
    </if>

    <section class=styles.panel>
      <h2>Raw console</h2>
      <p class=styles.muted>Write arbitrary bytes to any characteristic to reverse-engineer an unknown lamp.</p>
      <div class=styles.row>
        <input class=styles.mono style="width:6rem" value=rawService onInput(e) { rawService = (e.target as HTMLInputElement).value; } aria-label="service">
        <input class=styles.mono style="width:6rem" value=rawChar onInput(e) { rawChar = (e.target as HTMLInputElement).value; } aria-label="characteristic">
        <input class=[styles.mono, styles.grow] value=rawBytes onInput(e) { rawBytes = (e.target as HTMLInputElement).value; } aria-label="bytes">
        <button class=styles.primary disabled=!connected onClick() { sendRaw(); }>Send</button>
      </div>
    </section>

    <if=logs.length>
      <section class=styles.panel>
        <div class=styles.spread>
          <h2>Log</h2>
          <button onClick() { logs = []; }>Clear</button>
        </div>
        <div class=styles.log>
          <for|e| of=logs>
            <div class=[e.kind === "err" && styles.err, e.kind === "ok" && styles.good]>${e.msg}</div>
          </for>
        </div>
      </section>
    </if>

    <a class=styles.muted href="/">← lavalva.dev</a>
  </div>
</div>
