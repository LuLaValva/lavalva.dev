h1 -- Delete your kbd swipes

form method="post"
  label for="token" -- ID from Train swipes
  p
    input#token
      ,name="token"
      ,size=32
      ,required
      ,autocomplete="off"
      ,autocapitalize="off"
      ,spellcheck="false"
  button -- Delete

if="isDeleted" in $global.data
  p -- ${$global.data.isDeleted ? "Deleted." : "Nothing under that ID."}
