import styles from "./gif.module.css";
import type { Corner, Crop, Handle } from "./crop";
import type { RenderResult } from "./video";
import { type GifMode, playedFrameCount } from "./playback";
// Not a `client import`: HANDLES is read during render, and a client-only
// binding is undefined on the server.
import {
  FULL_CROP,
  HANDLES,
  MIN_OUTPUT_WIDTH,
  clamp,
  cropPixels,
  dragCrop,
  outputSize,
} from "./crop";
client import { prepareVideo, previewSeek, renderGif } from "./video";

// A few seconds of motion, without melting a phone.
static const MAX_FRAMES = 240;
// Browsers treat 0 or 1 as 10, so 2 is the real floor.
static const MIN_DELAY = 2;
static const ASSUMED_FRAME_SECONDS = 1 / 30;
static const ARROWS: Record<string, [number, number]> = {
  ArrowLeft: [-1, 0],
  ArrowRight: [1, 0],
  ArrowUp: [0, -1],
  ArrowDown: [0, 1],
};
static const HANDLE_LABELS: Record<Corner, string> = {
  nw: "top left",
  ne: "top right",
  sw: "bottom left",
  se: "bottom right",
};
static const STRIDES = [
  { value: 1, label: "All" },
  { value: 2, label: "1/2" },
  { value: 3, label: "1/3" },
  { value: 4, label: "1/4" },
  { value: 6, label: "1/6" },
];
static const PALETTES = [
  { value: 256, label: "256" },
  { value: 128, label: "128" },
  { value: 64, label: "64" },
  { value: 32, label: "32" },
];
static const MODES: { value: GifMode; label: string }[] = [
  { value: "loop", label: "Loop" },
  { value: "pingpong", label: "Ping-pong" },
  { value: "once", label: "Once" },
];

static function frameFit(span: number, step: number) {
  return Math.min(MAX_FRAMES, Math.max(1, Math.round(span / step)));
}

static function formatRate(perSecond: number) {
  return `${Math.round(perSecond * 10) / 10} fps`;
}

static function formatTime(seconds: number) {
  const minutes = Math.floor(seconds / 60);
  return `${minutes}:${(seconds - minutes * 60).toFixed(2).padStart(5, "0")}`;
}

static function formatBytes(bytes: number) {
  if (bytes < 1024) return `${bytes} B`;
  if (bytes < 1024 * 1024) return `${(bytes / 1024).toFixed(0)} kB`;
  return `${(bytes / 1024 / 1024).toFixed(1)} MB`;
}

<let/videoUrl="">
<let/fileName="">
<let/duration=0>
<let/naturalWidth=0>
<let/naturalHeight=0>
<let/dragOver=false>

<let/start=0>
<let/end=0>
<let/playing=false>

<let/crop=FULL_CROP as Crop>

<let/frameSeconds=ASSUMED_FRAME_SECONDS>
<let/frameRateSource="checking" as "checking" | "measured" | "assumed">
<let/stride=1>
// An exponent: even relative precision across 0.25x to 8x.
<let/speedExponent=0>
<let/mode="loop" as GifMode>
<let/requestedWidth=360>
<let/colors=256>
<let/dither=true>

<let/rendering=false>
<let/statusText="">
<let/progress=0>
<let/error="">
<let/result=(
  null as
    | (RenderResult & { url: string; file: File; shareable: boolean })
    | null
)>

// Speed is absent on purpose. Which frames get captured is a property of the
// source; speed only sets how long each is shown.
<const/sourceStep=stride * frameSeconds>
// Whole hundredths per frame, in a 16-bit field. The speed that comes back
// out is whatever that rounding allows.
<const/delay=clamp(
  Math.round((sourceStep * 100) / 2 ** speedExponent),
  MIN_DELAY,
  65535,
)>
<const/speed=(sourceStep * 100) / delay>
<const/fps=100 / delay>
<const/source=cropPixels(crop, naturalWidth, naturalHeight)>
// The same call the renderer makes, so the size promised is the size encoded.
<const/output=outputSize(crop, naturalWidth, naturalHeight, requestedWidth)>
<const/outWidth=output.width>
<const/outHeight=output.height>

<const/uncappedFrames=Math.max(1, Math.round((end - start) / sourceStep))>
<const/frameCount=frameFit(end - start, sourceStep)>
<const/playedFrames=playedFrameCount(frameCount, mode)>
<const/outputSeconds=(playedFrames * delay) / 100>
<const/downloadName=`${fileName.replace(/\.[^.]+$/, "") || "clip"}.gif`>

<const/loadFile(file: File | undefined | null) {
  if (!file) return;
  fileName = file.name;
  duration = 0;
  error = "";
  frameSeconds = ASSUMED_FRAME_SECONDS;
  frameRateSource = "checking";
  videoUrl = URL.createObjectURL(file);
}>

<const/applyDuration(value: number) {
  if (!Number.isFinite(value) || value <= 0 || duration === value) return;
  duration = value;
  start = 0;
  end = Math.min(value, 5);
}>

<const/seekTo(time: number) {
  const video = videoEl();
  video.pause();
  previewSeek(video, time);
}>

<const/snapEnd(from: number, to: number, step: number) {
  return Math.min(duration, from + frameFit(to - from, step) * step);
}>

// The start lands on any source frame. Only the end is held to the sampling
// stride, which is what keeps the handles independent.
<const/setStart(value: number) {
  start = clamp(
    Math.round(value / frameSeconds) * frameSeconds,
    0,
    Math.max(0, duration - sourceStep),
  );
  if (end < start + sourceStep) end = Math.min(duration, start + sourceStep);
  seekTo(start);
}>

<const/setEnd(value: number) {
  if (value < start + sourceStep) start = Math.max(0, value - sourceStep);
  end = snapEnd(start, value, sourceStep);
  seekTo(end);
}>

<const/setStride(value: number) {
  stride = value;
  end = snapEnd(start, end, stride * frameSeconds);
}>

<const/applyFrameSeconds(measured: number | null) {
  frameRateSource = measured === null ? "assumed" : "measured";
  frameSeconds = measured ?? ASSUMED_FRAME_SECONDS;
  start = Math.round(start / frameSeconds) * frameSeconds;
  end = snapEnd(start, end, stride * frameSeconds);
}>

<const/beginDrag(event: PointerEvent, el: HTMLElement, handle: Handle) {
  const box = stageEl().getBoundingClientRect();
  if (!box.width || !box.height) return;

  const originX = event.clientX;
  const originY = event.clientY;
  const origin = crop;
  el.setPointerCapture(event.pointerId);

  const stop = new AbortController();
  el.addEventListener(
    "pointermove",
    (moved: PointerEvent) => {
      crop = dragCrop(
        origin,
        handle,
        (moved.clientX - originX) / box.width,
        (moved.clientY - originY) / box.height,
      );
    },
    { signal: stop.signal },
  );
  for (const ending of ["pointerup", "pointercancel"]) {
    el.addEventListener(ending, () => stop.abort(), { signal: stop.signal });
  }
}>

<const/nudge(event: KeyboardEvent, handle: Handle) {
  const arrow = ARROWS[event.key];
  if (!arrow) return;
  // Alt means one source pixel. The crop is a fraction, so that differs per axis.
  const step = (natural: number) =>
    event.altKey ? 1 / Math.max(1, natural) : event.shiftKey ? 0.1 : 0.01;
  // Also stops alt+arrow navigating history.
  event.preventDefault();
  crop = dragCrop(
    crop,
    handle,
    arrow[0] * step(naturalWidth),
    arrow[1] * step(naturalHeight),
  );
}>

// The sheet's "Save Image" writes to the camera roll, skipping downloads.
<const/shareResult() {
  const shared = result;
  if (!shared) return;
  // Nothing awaited first: sharing needs the click's transient activation.
  // Files only. Given both, iOS shares the text.
  navigator.share({ files: [shared.file] }).catch((thrown: unknown) => {
    // Dismissing rejects too. Not a failure.
    if (thrown instanceof Error && thrown.name === "AbortError") return;
    error = "This browser wouldn't hand the file to the share sheet.";
  });
}>

// An arrow, not `async onClick()`: prettier-plugin-marko strips `async` off
// method shorthand and the await stops compiling.
<const/startRender=async () => {
  rendering = true;
  error = "";
  statusText = "Capturing frames";
  progress = 0;
  try {
    const rendered = await renderGif({
      video: videoEl(),
      crop,
      start,
      frameSeconds,
      stride,
      delay,
      mode,
      frameCount,
      width: outWidth,
      dither,
      colors,
      onProgress(current, fraction) {
        statusText = current;
        progress = fraction;
      },
    });
    const file = new File([rendered.blob], downloadName, { type: "image/gif" });
    result = {
      ...rendered,
      url: URL.createObjectURL(rendered.blob),
      file,
      // `canShare` needs no user gesture; `share` does.
      shareable: !!navigator.canShare?.({ files: [file] }),
    };
  } catch (thrown) {
    error = thrown instanceof Error ? thrown.message : "Rendering failed.";
  } finally {
    rendering = false;
    statusText = "";
  }
}>

<script>if (videoUrl) videoEl().playbackRate = speed;</script>

<script>
  // Object URLs pin their blob until revoked. A source video is often huge.
  const url = videoUrl;
  if (url) $signal.onabort = () => URL.revokeObjectURL(url);
</script>

<script>
  const url = result?.url;
  if (url) $signal.onabort = () => URL.revokeObjectURL(url);
</script>

<script>
  // ...and repaints at the export frame rate, sampling the video underneath,
  // so the preview stutters the way the GIF will.
  const video = videoEl();
  const canvas = previewCanvas();
  const ctx = canvas.getContext("2d");
  if (playing && ctx && video.videoWidth) {
    // Assigning either reallocates the backing store even when unchanged, and
    // this reruns on every speed-slider tick.
    if (canvas.width !== video.videoWidth) canvas.width = video.videoWidth;
    if (canvas.height !== video.videoHeight) canvas.height = video.videoHeight;
    const draw = () => ctx.drawImage(video, 0, 0, canvas.width, canvas.height);
    draw();
    const timer = setInterval(draw, delay * 10);
    $signal.onabort = () => clearInterval(timer);
  }
</script>

<main class=styles.page>
  <h1>GIF Editor</h1>
  <p class=styles.lede>
    Trim, crop and export a clip as a GIF. Everything happens in this tab — your
    video is never uploaded.
  </p>

  <section
    class=[
      styles.dropzone,
      videoUrl && styles.compact,
      dragOver && styles.armed,
    ]
    onDragOver(e) {
      e.preventDefault();
      dragOver = true;
    }
    onDragLeave() {
      dragOver = false;
    }
    onDrop(e: DragEvent) {
      e.preventDefault();
      dragOver = false;
      loadFile(e.dataTransfer?.files[0]);
    }
  >
    <label class=styles.pick>
      <input
        type="file"
        accept="video/*"
        onChange(e, el: HTMLInputElement) {
          loadFile(el.files?.[0]);
          el.value = "";
        }
      >
      <span>${videoUrl ? "Choose a different video" : "Choose a video"}</span>
    </label>
    <p class=styles.hint>${fileName || "…or drop one here"}</p>
  </section>

  <if=error>
    <p class=styles.error role="alert">${error}</p>
  </if>

  <show=!!videoUrl>
    <div class=styles.previewDock>
      <div/stageEl class=styles.stage>
        <video/videoEl
          class=styles.video
          src=videoUrl || null
          muted
          playsinline
          preload="auto"
          onLoadedMetadata(e, el: HTMLVideoElement) {
            naturalWidth = el.videoWidth;
            naturalHeight = el.videoHeight;
            crop = FULL_CROP;
            requestedWidth = Math.min(360, el.videoWidth || 360);
            if (Number.isFinite(el.duration)) {
              applyDuration(el.duration);
            } else {
              // Recordings with no duration header only admit their length
              // once you seek past the end.
              el.currentTime = 1e101;
            }
            prepareVideo(el, start).then(applyFrameSeconds);
          }
          onDurationChange(e, el: HTMLVideoElement) {
            applyDuration(el.duration);
            if (el.currentTime > el.duration) el.currentTime = 0;
          }
          onPause() {
            playing = false;
          }
          onEnded() {
            playing = false;
          }
          onTimeUpdate(e, el: HTMLVideoElement) {
            // Playback only. Otherwise scrubbing the end handle past `end`
            // yanks the preview to `start` and reads as jitter.
            if (rendering || el.paused || el.currentTime < end) return;
            el.currentTime = start;
          }
          onError() {
            error = "This browser can't play that video file.";
          }
        />

        <canvas/previewCanvas class=styles.preview hidden=!playing/>

        <div
          class=styles.cropBox
          style={
            left: `${crop.x * 100}%`,
            top: `${crop.y * 100}%`,
            width: `${crop.width * 100}%`,
            height: `${crop.height * 100}%`,
          }
        >
          <!-- A sibling of the handles, not their parent, so a pointerdown on
          a handle can't also start a move. -->
          <button
            class=styles.moveArea
            type="button"
            aria-label="Crop region: drag to move it, or use the arrow keys"
            onPointerDown(e: PointerEvent, el: HTMLElement) {
              beginDrag(e, el, "move");
            }
            onKeyDown(e: KeyboardEvent) {
              nudge(e, "move");
            }
          />
          <for|handle| of=HANDLES by=(h) => h>
            <button
              class=[styles.handle, styles[handle]]
              type="button"
              aria-label=`Crop ${HANDLE_LABELS[handle]} corner: drag, or use the arrow keys`
              onPointerDown(e: PointerEvent, el: HTMLElement) {
                beginDrag(e, el, handle);
              }
              onKeyDown(e: KeyboardEvent) {
                nudge(e, handle);
              }
            />
          </for>
        </div>
      </div>

      <p class=styles.playbar>
        <button
          class=styles.play
          type="button"
          aria-label=playing ? "Pause preview" : "Play preview"
          onClick() {
            const video = videoEl();
            if (video.paused) {
              if (video.currentTime < start || video.currentTime >= end) {
                video.currentTime = start;
              }
              video.play().then(
                () => (playing = true),
                () => {},
              );
            } else {
              video.pause();
            }
          }
        >
          ${playing ? "⏸" : "▶"}
        </button>
      </p>
    </div>

    <section>
      <p class=styles.hint>
        Drag the box or corners; arrow keys nudge (shift bigger, alt one pixel).
      </p>

      <p class=styles.meta>
        <span aria-live="polite">Crop ${source.sw}×${source.sh}</span>
        <button
          class=styles.link
          onClick() {
            crop = FULL_CROP;
          }
        >
          Reset crop
        </button>
      </p>
    </section>

    <section>
      <!-- Any position: the handlers snap, and a step grid would fight it. -->
      <slider-row
        label="Start"
        min=0
        max=duration
        step="any"
        value=start
        valueChange=setStart
      >
        ${formatTime(start)}
      </slider-row>
      <slider-row
        label="End"
        min=0
        max=duration
        step="any"
        value=end
        valueChange=setEnd
      >
        ${formatTime(end)}
      </slider-row>
      <p class=styles.meta>
        <span>${frameCount} frames selected</span>
        <span>${formatTime(Math.max(0, end - start))} of source</span>
      </p>
    </section>

    <section>
      <chip-group
        legend="Frames"
        name="stride"
        options=STRIDES
        value=stride
        valueChange=setStride
      />
      <p class=styles.hint>
        <if=frameRateSource === "measured">
          Source is ${formatRate(1 / frameSeconds)}; every GIF frame is a real one.
        </if>
        <else-if=frameRateSource === "assumed">
          This browser won't say what the source's frame rate is, so it's
          assumed to be ${formatRate(1 / frameSeconds)}.
        </else-if>
        <else>Checking the source's frame rate…</else>
      </p>

      <slider-row
        label="Speed"
        min=-2
        max=3
        step=0.05
        value=speedExponent
        valueChange=(next) => (speedExponent = next)
      >
        ${speed.toFixed(2)}×
      </slider-row>
      <p class=styles.hint>
        A GIF holds whole hundredths of a second per frame, so nearby speeds
        round to the same one.
      </p>

      <slider-row
        label="Width"
        min=MIN_OUTPUT_WIDTH
        max=output.limit
        step=10
        value=outWidth
        valueChange=(next) => (requestedWidth = next)
      >
        ${outWidth}px
      </slider-row>
      <chip-group legend="Playback" name="mode" options=MODES value:=mode/>

      <chip-group legend="Colors" name="colors" options=PALETTES value:=colors/>

      <label class=styles.check>
        <input type="checkbox" checked:=dither>
        <span>Dither — smoother gradients, slightly larger file</span>
      </label>
    </section>

    <section>
      <p class=styles.summary>
        ${outWidth}×${outHeight}, ${playedFrames} frames at ${formatRate(fps)} — ${
          outputSeconds.toFixed(2)
        }s of GIF
        <if=(uncappedFrames > MAX_FRAMES)>
          <em>
            — capped at ${MAX_FRAMES} captured frames, so the clip will cut
            short. Trim it, or sample fewer frames.
          </em>
        </if>
      </p>

      <button
        class=styles.render
        disabled=rendering || !duration
        onClick() {
          startRender();
        }
      >
        ${rendering ? "Rendering…" : "Render GIF"}
      </button>

      <if=rendering>
        <p class=styles.progress>
          <progress value=progress max="1"/>
          <span>${statusText}… ${Math.round(progress * 100)}%</span>
        </p>
      </if>
    </section>

    <if=result>
      <section>
        <h2>Result</h2>
        <img
          class=styles.result
          src=result.url
          alt="the rendered gif"
          width=result.width
          height=result.height
        >
        <p class=styles.meta>
          <span class=styles.actions>
            <a class=styles.download href=result.url download=downloadName>
              Download
            </a>
            <if=result.shareable>
              <button
                class=[styles.link, styles.download]
                onClick() {
                  shareResult();
                }
              >
                Share
              </button>
            </if>
          </span>
          <span>
            ${result.width}×${result.height} · ${result.frames} frames ·
            ${formatBytes(result.blob.size)}
          </span>
        </p>
        <if=result.shareable>
          <p class=styles.hint>
            Share opens the system sheet — on iOS, “Save Image” there puts the
            GIF straight in your camera roll.
          </p>
        </if>
      </section>
    </if>
  </show>
</main>
