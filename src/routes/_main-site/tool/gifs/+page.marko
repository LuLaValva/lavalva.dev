import styles from "./gif.module.css";
import type { Corner, Crop, Handle } from "./crop";
import type { RenderResult } from "./video";
import { type GifMode, playedFrameCount } from "./playback";
// Not a `client import` — HANDLES is read while rendering, and a client-only
// binding is undefined on the server, which renders the handles away entirely.
import {
  FULL_CROP,
  HANDLES,
  MIN_OUTPUT_WIDTH,
  clamp,
  cropPixels,
  dragCrop,
  outputSize,
} from "./crop";
client import { prepareVideo, previewSeek, renderGif } from "./video";

// Enough for a few seconds of smooth motion without melting a phone.
static const MAX_FRAMES = 240;
// Browsers treat a delay of 0 or 1 hundredth as 10, so 2 is the real floor.
static const MIN_DELAY = 2;
// Firefox has no way to report a video's frame rate; assume the most common one
// so the tool still works there, just without exact frame boundaries.
static const ASSUMED_FRAME_SECONDS = 1 / 30;
static const ARROWS: Record<string, [number, number]> = {
  ArrowLeft: [-1, 0],
  ArrowRight: [1, 0],
  ArrowUp: [0, -1],
  ArrowDown: [0, 1],
};
static const HANDLE_LABELS: Record<Corner, string> = {
  nw: "top left",
  ne: "top right",
  sw: "bottom left",
  se: "bottom right",
};
// Every output frame is a real source frame, so sampling is always a whole
// fraction of the source's own rate — never an interpolation between frames.
static const STRIDES = [
  { value: "1", label: "All" },
  { value: "2", label: "1/2" },
  { value: "3", label: "1/3" },
  { value: "4", label: "1/4" },
  { value: "6", label: "1/6" },
];
// Fewer colors means a smaller file; flat or screen-recorded footage barely
// notices the drop, photographic footage does.
static const PALETTES = [
  { value: "256", label: "256" },
  { value: "128", label: "128" },
  { value: "64", label: "64" },
  { value: "32", label: "32" },
];
static const MODES = [
  { value: "loop", label: "Loop" },
  { value: "pingpong", label: "Ping-pong" },
  { value: "once", label: "Once" },
];

// How many output frames fit in a span, kept to at least one and to whatever
// the encoder can be trusted with.
static function frameFit(span: number, step: number) {
  return Math.min(MAX_FRAMES, Math.max(1, Math.round(span / step)));
}

// The end always sits on a frame boundary a whole number of steps from the
// start. Every control that moves the grid — the end handle, the sampling
// stride, a newly measured frame rate — puts it back through here.
static function snapEnd(from: number, to: number, step: number, limit: number) {
  return Math.min(limit, from + frameFit(to - from, step) * step);
}

static function formatRate(perSecond: number) {
  return `${Math.round(perSecond * 10) / 10} fps`;
}

static function formatTime(seconds: number) {
  const minutes = Math.floor(seconds / 60);
  return `${minutes}:${(seconds - minutes * 60).toFixed(2).padStart(5, "0")}`;
}

static function formatBytes(bytes: number) {
  if (bytes < 1024) return `${bytes} B`;
  if (bytes < 1024 * 1024) return `${(bytes / 1024).toFixed(0)} kB`;
  return `${(bytes / 1024 / 1024).toFixed(1)} MB`;
}

<let/videoUrl="">
<let/fileName="">
<let/duration=0>
<let/naturalWidth=0>
<let/naturalHeight=0>
<let/dragOver=false>

<let/start=0>
<let/end=0>
<let/playing=false>

<let/crop=FULL_CROP as Crop>

// undefined while the measurement is still running — it takes a few frames of
// playback to arrive, and claiming either way before then is a lie. null once
// the browser has been asked and had no answer.
<let/measuredFrameSeconds=undefined as number | null | undefined>
<let/strideChoice="1">
// Speed rides an exponent so a drag covers 0.25× to 8× with the same relative
// precision everywhere, instead of crawling at the bottom of the range.
<let/speedExponent=0>
<let/mode="loop">
<let/requestedWidth=360>
<let/colorsChoice="256">
<let/dither=true>

<let/rendering=false>
<let/statusText="">
<let/progress=0>
<let/error="">
// `file` is kept alongside the blob because sharing has to happen inside the
// click that asked for it, with nothing awaited in between.
<let/result=(
  null as
    | (RenderResult & { url: string; file: File; shareable: boolean })
    | null
)>

<const/colors=+colorsChoice>
<const/stride=+strideChoice>
<const/frameSeconds=measuredFrameSeconds ?? ASSUMED_FRAME_SECONDS>
// Seconds of source video between two captured frames. Speed deliberately
// doesn't enter into it: which frames get captured is a property of the source,
// and speed only decides how long each one is shown for.
<const/sourceStep=stride * frameSeconds>
<const/targetSpeed=2 ** speedExponent>
// The GIF can only hold a whole number of hundredths per frame — in one 16-bit
// field — so the speed that comes back out is whatever that rounding allows.
<const/delay=clamp(
  Math.round((sourceStep * 100) / targetSpeed),
  MIN_DELAY,
  65535,
)>
<const/speed=(sourceStep * 100) / delay>
<const/fps=100 / delay>
<const/source=cropPixels(crop, naturalWidth, naturalHeight)>
// The same computation the renderer will do, so what's promised below is what
// gets encoded rather than two roundings that happen to agree.
<const/output=outputSize(crop, naturalWidth, naturalHeight, requestedWidth)>
<const/outWidth=output.width>
<const/outHeight=output.height>

<const/uncappedFrames=Math.max(1, Math.round((end - start) / sourceStep))>
<const/frameCount=frameFit(end - start, sourceStep)>
// `checkedValue` binds a plain string, so narrow it back once, here.
<const/gifMode=mode as GifMode>
<const/playedFrames=playedFrameCount(frameCount, gifMode)>
<const/outputSeconds=(playedFrames * delay) / 100>
<const/downloadName=`${fileName.replace(/\.[^.]+$/, "") || "clip"}.gif`>

<const/loadFile(file: File | undefined | null) {
  if (!file) return;
  fileName = file.name;
  duration = 0;
  error = "";
  // Don't let the previous video's frame rate stand in for this one's.
  measuredFrameSeconds = undefined;
  videoUrl = URL.createObjectURL(file);
}>

<const/applyDuration(value: number) {
  if (!Number.isFinite(value) || value <= 0 || duration === value) return;
  duration = value;
  start = 0;
  end = Math.min(value, 5);
}>

<const/seekTo(time: number) {
  const video = videoEl();
  video.pause();
  previewSeek(video, time);
}>

<const/setStart(value: number) {
  // The start lands on any source frame; only the end is held to the sampling
  // stride, so the two handles stay independent.
  const onFrame = Math.round(value / frameSeconds) * frameSeconds;
  const next = clamp(onFrame, 0, Math.max(0, duration - sourceStep));
  start = next;
  // Pushed past the end? Take it along rather than refusing to move.
  if (end < next + sourceStep) end = Math.min(duration, next + sourceStep);
  seekTo(next);
}>

<const/setEnd(value: number) {
  const next = clamp(value, sourceStep, duration);
  // Pushed past the start? Take it along rather than refusing to move.
  const nextStart = Math.min(start, Math.max(0, next - sourceStep));
  const snapped = snapEnd(nextStart, next, sourceStep, duration);
  start = nextStart;
  end = snapped;
  seekTo(snapped);
}>

// Both of these move the frame grid underneath the trim, so pull the end back
// onto it. The start is only re-snapped when the grid itself changed.
<const/setStride(value: string) {
  strideChoice = value;
  end = snapEnd(start, end, +value * frameSeconds, duration);
}>

<const/applyFrameSeconds(seconds: number | null) {
  measuredFrameSeconds = seconds;
  const next = seconds ?? ASSUMED_FRAME_SECONDS;
  // Both derived from the values on the way in — a state write isn't
  // guaranteed to read back within the same handler.
  const nextStart = Math.round(start / next) * next;
  end = snapEnd(nextStart, end, stride * next, duration);
  start = nextStart;
}>

<const/beginDrag(event: PointerEvent, el: HTMLElement, handle: Handle) {
  const box = stageEl().getBoundingClientRect();
  if (!box.width || !box.height) return;

  const originX = event.clientX;
  const originY = event.clientY;
  const origin = crop;
  el.setPointerCapture(event.pointerId);

  const stop = new AbortController();
  el.addEventListener(
    "pointermove",
    (moved: PointerEvent) => {
      crop = dragCrop(
        origin,
        handle,
        (moved.clientX - originX) / box.width,
        (moved.clientY - originY) / box.height,
      );
    },
    { signal: stop.signal },
  );
  for (const ending of ["pointerup", "pointercancel"]) {
    el.addEventListener(ending, () => stop.abort(), { signal: stop.signal });
  }
}>

<const/nudge(event: KeyboardEvent, handle: Handle) {
  const arrow = ARROWS[event.key];
  if (!arrow) return;
  // Alt holds it to a single source pixel; the crop is stored as a fraction,
  // so one pixel is a different step on each axis.
  const step = (natural: number) =>
    event.altKey ? 1 / Math.max(1, natural) : event.shiftKey ? 0.1 : 0.01;
  // Also stops alt+arrow from triggering browser history navigation.
  event.preventDefault();
  crop = dragCrop(
    crop,
    handle,
    arrow[0] * step(naturalWidth),
    arrow[1] * step(naturalHeight),
  );
}>

// Hands the GIF to the system share sheet, where iOS offers "Save Image" and
// writes it straight to the camera roll — the download folder detour is what
// this is here to skip.
<const/shareResult() {
  const shared = result;
  if (!shared) return;
  // Nothing awaited before this call: sharing needs the click's transient
  // activation, and anything awaited in between can spend it.
  // Files only, no title or text — iOS shares the text instead when given both.
  navigator.share({ files: [shared.file] }).catch((thrown: unknown) => {
    // Dismissing the sheet rejects too, and that isn't a failure.
    if (thrown instanceof Error && thrown.name === "AbortError") return;
    error = "This browser wouldn't hand the file to the share sheet.";
  });
}>

// An arrow, not `async onClick()` — prettier-plugin-marko drops the `async`
// keyword off a method-shorthand handler and the await stops compiling.
<const/startRender=async () => {
  rendering = true;
  error = "";
  statusText = "Capturing frames";
  progress = 0;
  try {
    const rendered = await renderGif({
      video: videoEl(),
      crop,
      start,
      frameSeconds,
      stride,
      delay,
      mode: gifMode,
      frameCount,
      width: outWidth,
      dither,
      colors,
      onProgress(current, fraction) {
        statusText = current;
        progress = fraction;
      },
    });
    const file = new File([rendered.blob], downloadName, { type: "image/gif" });
    result = {
      ...rendered,
      url: URL.createObjectURL(rendered.blob),
      file,
      // Settled now rather than at click time: `canShare` needs no user
      // gesture, and asking it costs nothing here.
      shareable: !!navigator.canShare?.({ files: [file] }),
    };
  } catch (thrown) {
    error = thrown instanceof Error ? thrown.message : "Rendering failed.";
  } finally {
    rendering = false;
    statusText = "";
  }
}>

<script>
  // The preview plays at the export speed.
  if (videoUrl) videoEl().playbackRate = speed;
</script>

<script>
  // Object URLs pin their blob until revoked, and a source video is routinely
  // hundreds of megabytes. Replacements are revoked where they're replaced;
  // these release whatever is still held when the page goes away.
  const url = videoUrl;
  if (url) $signal.onabort = () => URL.revokeObjectURL(url);
</script>

<script>
  const url = result?.url;
  if (url) $signal.onabort = () => URL.revokeObjectURL(url);
</script>

<script>
  // ...and repaints only at the export frame rate, so the preview stutters
  // exactly the way the GIF will. The video underneath keeps playing smoothly;
  // this samples it. Reruns whenever playback starts or the rate changes.
  const video = videoEl();
  const canvas = previewCanvas();
  const ctx = canvas.getContext("2d");
  if (playing && ctx && video.videoWidth) {
    // Assigning either of these reallocates and clears the backing store even
    // when the value is unchanged, and this effect reruns on every tick of the
    // speed slider — so only assign when the size actually differs.
    if (canvas.width !== video.videoWidth) canvas.width = video.videoWidth;
    if (canvas.height !== video.videoHeight) canvas.height = video.videoHeight;
    const draw = () => ctx.drawImage(video, 0, 0, canvas.width, canvas.height);
    draw();
    const timer = setInterval(draw, delay * 10);
    $signal.onabort = () => clearInterval(timer);
  }
</script>

<main class=styles.page>
  <h1>GIF Editor</h1>
  <p class=styles.lede>
    Trim, crop and export a clip as a GIF. Everything happens in this tab — your
    video is never uploaded.
  </p>

  <section
    class=[
      styles.dropzone,
      videoUrl && styles.compact,
      dragOver && styles.armed,
    ]
    onDragOver(e) {
      e.preventDefault();
      dragOver = true;
    }
    onDragLeave() {
      dragOver = false;
    }
    onDrop(e: DragEvent) {
      e.preventDefault();
      dragOver = false;
      loadFile(e.dataTransfer?.files[0]);
    }
  >
    <label class=styles.pick>
      <input
        type="file"
        accept="video/*"
        onChange(e, el: HTMLInputElement) {
          loadFile(el.files?.[0]);
          el.value = "";
        }
      >
      <span>${videoUrl ? "Choose a different video" : "Choose a video"}</span>
    </label>
    <p class=styles.hint>${fileName || "…or drop one here"}</p>
  </section>

  <if=error>
    <p class=styles.error role="alert">${error}</p>
  </if>

  <show=!!videoUrl>
    <div class=styles.previewDock>
      <div/stageEl class=styles.stage>
        <video/videoEl
          class=styles.video
          src=videoUrl || null
          muted
          playsinline
          preload="auto"
          onLoadedMetadata(e, el: HTMLVideoElement) {
            naturalWidth = el.videoWidth;
            naturalHeight = el.videoHeight;
            crop = FULL_CROP;
            requestedWidth = Math.min(360, el.videoWidth || 360);
            if (Number.isFinite(el.duration)) {
              applyDuration(el.duration);
            } else {
              // Recordings without a duration header only admit their length
              // once you seek past the end.
              el.currentTime = 1e101;
            }
            prepareVideo(el, start).then(applyFrameSeconds);
          }
          onDurationChange(e, el: HTMLVideoElement) {
            applyDuration(el.duration);
            if (el.currentTime > el.duration) el.currentTime = 0;
          }
          onPause() {
            playing = false;
          }
          onEnded() {
            playing = false;
          }
          onTimeUpdate(e, el: HTMLVideoElement) {
            // Only wrap around during playback. Without the paused check,
            // scrubbing the end handle past `end` immediately yanked the
            // preview back to `start`, which read as the video jittering.
            if (rendering || el.paused || el.currentTime < end) return;
            el.currentTime = start;
          }
          onError() {
            error = "This browser can't play that video file.";
          }
        />

        <canvas/previewCanvas class=styles.preview hidden=!playing/>

        <div
          class=styles.cropBox
          style={
            left: `${crop.x * 100}%`,
            top: `${crop.y * 100}%`,
            width: `${crop.width * 100}%`,
            height: `${crop.height * 100}%`,
          }
        >
          <!-- A sibling of the handles, not their parent, so a pointerdown on
          a handle can never also start a move. -->
          <button
            class=styles.moveArea
            type="button"
            aria-label="Crop region: drag to move it, or use the arrow keys"
            onPointerDown(e: PointerEvent, el: HTMLElement) {
              beginDrag(e, el, "move");
            }
            onKeyDown(e: KeyboardEvent) {
              nudge(e, "move");
            }
          />
          <for|handle| of=HANDLES by=(h) => h>
            <button
              class=[styles.handle, styles[handle]]
              type="button"
              aria-label=`Crop ${HANDLE_LABELS[handle]} corner: drag, or use the arrow keys`
              onPointerDown(e: PointerEvent, el: HTMLElement) {
                beginDrag(e, el, handle);
              }
              onKeyDown(e: KeyboardEvent) {
                nudge(e, handle);
              }
            />
          </for>
        </div>
      </div>

      <p class=styles.playbar>
        <button
          class=styles.play
          type="button"
          aria-label=playing ? "Pause preview" : "Play preview"
          onClick() {
            const video = videoEl();
            if (video.paused) {
              if (video.currentTime < start || video.currentTime >= end) {
                video.currentTime = start;
              }
              video.play().then(
                () => (playing = true),
                () => {},
              );
            } else {
              video.pause();
            }
          }
        >
          ${playing ? "⏸" : "▶"}
        </button>
      </p>
    </div>

    <section>
      <p class=styles.hint>
        Drag the box or corners; arrow keys nudge (shift bigger, alt one pixel).
      </p>

      <p class=styles.meta>
        <span aria-live="polite">Crop ${source.sw}×${source.sh}</span>
        <button
          class=styles.link
          onClick() {
            crop = FULL_CROP;
          }
        >
          Reset crop
        </button>
      </p>
    </section>

    <section>
      <!-- Both sliders take any position: the handlers do the snapping, and a
      step grid of their own would only fight it. -->
      <slider-row
        label="Start"
        min=0
        max=duration
        step="any"
        value=start
        valueChange=setStart
      >
        ${formatTime(start)}
      </slider-row>
      <slider-row
        label="End"
        min=0
        max=duration
        step="any"
        value=end
        valueChange=setEnd
      >
        ${formatTime(end)}
      </slider-row>
      <p class=styles.meta>
        <span>${frameCount} frames selected</span>
        <span>${formatTime(Math.max(0, end - start))} of source</span>
      </p>
    </section>

    <section>
      <chip-group
        legend="Frames"
        name="stride"
        options=STRIDES
        value=strideChoice
        valueChange=setStride
      />
      <p class=styles.hint>
        <if=measuredFrameSeconds != null>
          Source is ${formatRate(1 / frameSeconds)}; every GIF frame is a real one.
        </if>
        <else-if=measuredFrameSeconds === null>
          This browser won't say what the source's frame rate is, so it's
          assumed to be ${formatRate(1 / frameSeconds)}.
        </else-if>
        <else>Checking the source's frame rate…</else>
      </p>

      <slider-row
        label="Speed"
        min=-2
        max=3
        step=0.05
        value=speedExponent
        valueChange=(next) => (speedExponent = next)
      >
        ${speed.toFixed(2)}×
      </slider-row>
      <p class=styles.hint>
        A GIF holds whole hundredths of a second per frame, so nearby speeds
        round to the same one.
      </p>

      <slider-row
        label="Width"
        min=MIN_OUTPUT_WIDTH
        max=output.limit
        step=10
        value=outWidth
        valueChange=(next) => (requestedWidth = next)
      >
        ${outWidth}px
      </slider-row>
      <chip-group legend="Playback" name="mode" options=MODES value:=mode/>

      <chip-group
        legend="Colors"
        name="colors"
        options=PALETTES
        value:=colorsChoice
      />

      <label class=styles.check>
        <input type="checkbox" checked:=dither>
        <span>Dither — smoother gradients, slightly larger file</span>
      </label>
    </section>

    <section>
      <p class=styles.summary>
        ${outWidth}×${outHeight}, ${playedFrames} frames at ${formatRate(fps)} — ${
          outputSeconds.toFixed(2)
        }s of GIF
        <if=(uncappedFrames > MAX_FRAMES)>
          <em>
            — capped at ${MAX_FRAMES} captured frames, so the clip will cut
            short. Trim it, or sample fewer frames.
          </em>
        </if>
      </p>

      <button
        class=styles.render
        disabled=rendering || !duration
        onClick() {
          startRender();
        }
      >
        ${rendering ? "Rendering…" : "Render GIF"}
      </button>

      <if=rendering>
        <p class=styles.progress>
          <progress value=progress max="1"/>
          <span>${statusText}… ${Math.round(progress * 100)}%</span>
        </p>
      </if>
    </section>

    <if=result>
      <section>
        <h2>Result</h2>
        <img
          class=styles.result
          src=result.url
          alt="the rendered gif"
          width=result.width
          height=result.height
        >
        <p class=styles.meta>
          <span class=styles.actions>
            <a class=styles.download href=result.url download=downloadName>
              Download
            </a>
            <if=result.shareable>
              <button
                class=[styles.link, styles.download]
                onClick() {
                  shareResult();
                }
              >
                Share
              </button>
            </if>
          </span>
          <span>
            ${result.width}×${result.height} · ${result.frames} frames ·
            ${formatBytes(result.blob.size)}
          </span>
        </p>
        <if=result.shareable>
          <p class=styles.hint>
            Share opens the system sheet — on iOS, “Save Image” there puts the
            GIF straight in your camera roll.
          </p>
        </if>
      </section>
    </if>
  </show>
</main>
