import styles from "../gif.module.css";

export interface Input<T extends string | number> {
  legend: string;
  name: string;
  options: { value: T; label: string }[];
  value: T;
  valueChange: (value: T) => void;
}

// Radios carry strings; the round trip back to the caller's type stays here.
<fieldset class=styles.chips>
  <legend>${input.legend}</legend>
  <for|option| of=input.options by="value">
    <label class=styles.chip>
      <input
        type="radio"
        name=input.name
        value=String(option.value)
        checkedValue=String(input.value)
        checkedValueChange(picked: string) {
          const match = input.options.find((o) => String(o.value) === picked);
          if (match) input.valueChange(match.value);
        }
      >
      <span>${option.label}</span>
    </label>
  </for>
</fieldset>
