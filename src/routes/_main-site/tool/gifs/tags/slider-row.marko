import styles from "../gif.module.css";

export interface Input {
  label: string;
  min: number | string;
  max: number | string;
  step: number | string;
  value: number;
  valueChange: (value: number) => void;
  /** What the readout shows — often a derived value, not the bound one. */
  content: Marko.Body;
}

<label class=styles.slider>
  <span>${input.label}</span>
  <input
    type="range"
    min=input.min
    max=input.max
    step=input.step
    value=input.value
    valueChange(next) {
      input.valueChange(+next);
    }
  >
  <output>
    <${input.content}/>
  </output>
</label>
