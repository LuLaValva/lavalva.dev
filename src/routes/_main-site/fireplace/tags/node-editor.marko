import { produce } from "immer";
import styles from "../flow.module.css";
import { DEFS, nextId, type Edge, type Graph, type GraphNode } from "../flow";

export interface Input {
  graph: Graph;
  graphChange: (graph: Graph) => void;
}

// Geometry shared by the CSS layout and the wire endpoints: 26px header,
// then one 24px row per port (inputs stacked above outputs).
static const NODE_W = 130;
static const HEADER = 26;
static const ROW = 24;

static function portPos(node: GraphNode, kind: "in" | "out", idx: number) {
  const row = kind === "in" ? idx : DEFS[node.type].inputs.length + idx;
  return {
    x: node.x + (kind === "in" ? 0 : NODE_W),
    y: node.y + HEADER + row * ROW + ROW / 2,
  };
}

static function wirePath(
  a: { x: number; y: number },
  b: { x: number; y: number },
) {
  return `M ${a.x} ${a.y} C ${a.x + 50} ${a.y}, ${b.x - 50} ${b.y}, ${b.x} ${b.y}`;
}

// A wire mid-drag: exactly one end is anchored to a port.
<let/pending=null as {
  from?: [number, number];
  to?: [number, number];
  x: number;
  y: number;
} | null>
<let/addType="noise">

<const/update(edit: (draft: Graph) => void) {
  input.graphChange(produce(input.graph, edit));
}>

<const/node(id: number) {
  return input.graph.nodes.find((n) => n.id === id);
}>

<const/wiredInputs=new Set(input.graph.edges.map((e) => e.to.join(":")))>
<const/wiredOutputs=new Set(input.graph.edges.map((e) => e.from.join(":")))>

<const/dragNode(event: PointerEvent, el: HTMLElement, id: number) {
  const origin = node(id)!;
  const startX = event.clientX;
  const startY = event.clientY;
  const baseX = origin.x;
  const baseY = origin.y;
  el.setPointerCapture(event.pointerId);
  const stop = new AbortController();
  el.addEventListener(
    "pointermove",
    (moved: PointerEvent) => {
      update((d) => {
        const n = d.nodes.find((n) => n.id === id)!;
        n.x = Math.max(0, baseX + moved.clientX - startX);
        n.y = Math.max(0, baseY + moved.clientY - startY);
      });
    },
    { signal: stop.signal },
  );
  for (const ending of ["pointerup", "pointercancel"]) {
    el.addEventListener(ending, () => stop.abort(), { signal: stop.signal });
  }
}>

// Ports connect by dragging: output → input (or the reverse). Grabbing an
// already-wired input picks that wire up instead, so dropping it in empty
// space deletes it.
<const/dragWire(
  event: PointerEvent,
  el: HTMLElement,
  kind: "in" | "out",
  id: number,
  idx: number,
) {
  event.stopPropagation();
  let from: [number, number] | undefined =
    kind === "out" ? [id, idx] : undefined;
  let to: [number, number] | undefined = kind === "in" ? [id, idx] : undefined;
  if (to) {
    const existing = input.graph.edges.find(
      (e) => e.to[0] === id && e.to[1] === idx,
    );
    if (existing) {
      from = existing.from;
      to = undefined;
      update((d) => {
        d.edges = d.edges.filter((e) => !(e.to[0] === id && e.to[1] === idx));
      });
    }
  }
  el.setPointerCapture(event.pointerId);
  const rect = canvasEl().getBoundingClientRect();
  const track = (ev: PointerEvent) => {
    pending = { from, to, x: ev.clientX - rect.left, y: ev.clientY - rect.top };
  };
  track(event);
  const stop = new AbortController();
  el.addEventListener("pointermove", track, { signal: stop.signal });
  el.addEventListener(
    "pointercancel",
    () => {
      stop.abort();
      pending = null;
    },
    { signal: stop.signal },
  );
  el.addEventListener(
    "pointerup",
    (up: PointerEvent) => {
      stop.abort();
      pending = null;
      const hit = document
        .elementFromPoint(up.clientX, up.clientY)
        ?.closest(from ? "[data-in]" : "[data-out]");
      if (!(hit instanceof HTMLElement)) return;
      const [hid, hidx] = (hit.dataset.in ?? hit.dataset.out)!
        .split(":")
        .map(Number);
      const edge: Edge = from
        ? { from, to: [hid, hidx] }
        : { from: [hid, hidx], to: to! };
      if (edge.from[0] === edge.to[0] && edge.from[1] === edge.to[1]) return;
      update((d) => {
        // An input holds at most one wire; the new one wins.
        d.edges = d.edges.filter(
          (e) => !(e.to[0] === edge.to[0] && e.to[1] === edge.to[1]),
        );
        d.edges.push(edge);
      });
    },
    { signal: stop.signal },
  );
}>

<div class=styles.toolbar>
  <label>
    add node:
    <select
      value=addType
      valueChange(v) {
        addType = v;
      }
    >
      <for|type| of=Object.keys(DEFS).filter((t) => t !== "lamp")>
        <option value=type title=DEFS[type].doc>
          ${DEFS[type].label} — ${DEFS[type].doc}
        </option>
      </for>
    </select>
  </label>
  <button onClick() {
    update((d) => {
      d.nodes.push({
        id: nextId(d),
        type: addType,
        x: 20,
        y: 20,
        params: DEFS[addType].inputs.map((i) => i.def),
      });
    });
  }>
    Add
  </button>
</div>

<div class=styles.stage>
  <div/canvasEl class=styles.canvas>
    <svg class=styles.wires>
      <for|edge| of=input.graph.edges>
        <const/a=node(edge.from[0])>
        <const/b=node(edge.to[0])>
        <if=a && b>
          <path
            class=styles.wire
            d=wirePath(
              portPos(a, "out", edge.from[1]),
              portPos(b, "in", edge.to[1]),
            )
          />
        </if>
      </for>
      <if=pending>
        <const/anchor=(
          pending.from
            ? portPos(node(pending.from[0])!, "out", pending.from[1])
            : portPos(node(pending.to![0])!, "in", pending.to![1])
        )>
        <path
          class=styles.pendingWire
          d=pending.from ? wirePath(anchor, pending) : wirePath(pending, anchor)
        />
      </if>
    </svg>
    <for|n| of=input.graph.nodes by=(n) => String(n.id)>
      <const/def=DEFS[n.type]>
      <div class=styles.node style=`left:${n.x}px;top:${n.y}px` title=def.doc>
        <div
          class=styles.header
          onPointerDown(e: PointerEvent, el: HTMLElement) {
            dragNode(e, el, n.id);
          }
        >
          <span>${def.label}</span>
          <if=n.type !== "lamp">
            <button
              aria-label=`delete ${def.label}`
              onPointerDown(e: PointerEvent) {
                e.stopPropagation();
              }
              onClick() {
                update((d) => {
                  d.nodes = d.nodes.filter((x) => x.id !== n.id);
                  d.edges = d.edges.filter(
                    (e) => e.from[0] !== n.id && e.to[0] !== n.id,
                  );
                });
              }
            >
              ×
            </button>
          </if>
        </div>
        <for|port, i| of=def.inputs>
          <div class=styles.row>
            <span
              class=[
                styles.port,
                wiredInputs.has(`${n.id}:${i}`) && styles.connected,
              ]
              data-in=`${n.id}:${i}`
              onPointerDown(e: PointerEvent, el: HTMLElement) {
                dragWire(e, el, "in", n.id, i);
              }
            />
            <span>${port.name}</span>
            <if=!wiredInputs.has(`${n.id}:${i}`)>
              <input
                type="number"
                step="0.05"
                aria-label=`${def.label} ${port.name}`
                value=String(n.params[i] ?? port.def)
                valueChange(v) {
                  update((d) => {
                    d.nodes.find((x) => x.id === n.id)!.params[i] = +v || 0;
                  });
                }
              >
            </if>
          </div>
        </for>
        <for|name, j| of=def.outputs>
          <div class=[styles.row, styles.output]>
            <span>${name}</span>
            <span
              class=[
                styles.port,
                wiredOutputs.has(`${n.id}:${j}`) && styles.connected,
              ]
              data-out=`${n.id}:${j}`
              onPointerDown(e: PointerEvent, el: HTMLElement) {
                dragWire(e, el, "out", n.id, j);
              }
            />
          </div>
        </for>
      </div>
    </for>
  </div>
</div>
