  </div>
</show>

<show=spaceId === "oklab">
  <let-search/kl=(SPACES.oklab.presets[0].channels[0]) key="kl" active=spaceId === "oklab"/>
  <let-search/ka=(SPACES.oklab.presets[0].channels[1]) key="ka" active=spaceId === "oklab"/>
  <let-search/kb=(SPACES.oklab.presets[0].channels[2]) key="kb" active=spaceId === "oklab"/>
  <script>
    if (spaceId === "oklab") colorSrcs = [kl, ka, kb];
  </script>
  <div class=styles.fields>
    <preset-select
      presets=SPACES.oklab.presets
      load(c) {
        [kl, ka, kb, w] = c;
      }
    />
    <expr-input name="l" value:=kl/>
    <expr-input name="a" value:=ka/>
    <expr-input name="b" value:=kb/>
    <expr-input name="w" value:=w/>
  </div>
</show>

<show=spaceId === "lch">
  <let-search/cl=(SPACES.lch.presets[0].channels[0]) key="cl" active=spaceId === "lch"/>
  <let-search/cc=(SPACES.lch.presets[0].channels[1]) key="cc" active=spaceId === "lch"/>
  <let-search/ch=(SPACES.lch.presets[0].channels[2]) key="ch" active=spaceId === "lch"/>
  <script>
    if (spaceId === "lch") colorSrcs = [cl, cc, ch];
  </script>
  <div class=styles.fields>
    <preset-select
      presets=SPACES.lch.presets
      load(c) {
        [cl, cc, ch, w] = c;
      }
    />
    <expr-input name="l" value:=cl/>
    <expr-input name="c" value:=cc/>
    <expr-input name="h" value:=ch/>
    <expr-input name="w" value:=w/>
  </div>
</show>

<show=spaceId === "lab">
  <let-search/ll=(SPACES.lab.presets[0].channels[0]) key="ll" active=spaceId === "lab"/>
  <let-search/la=(SPACES.lab.presets[0].channels[1]) key="la" active=spaceId === "lab"/>
  <let-search/lb=(SPACES.lab.presets[0].channels[2]) key="lb" active=spaceId === "lab"/>
  <script>
    if (spaceId === "lab") colorSrcs = [ll, la, lb];
  </script>
  <div class=styles.fields>
    <preset-select
      presets=SPACES.lab.presets
      load(c) {
        [ll, la, lb, w] = c;
      }
    />
    <expr-input name="l" value:=ll/>
    <expr-input name="a" value:=la/>
    <expr-input name="b" value:=lb/>
    <expr-input name="w" value:=w/>
  </div>
</show>

<if=wants.s || wants.m>
  <p class=styles.audio>
    <if=wants.s>
      <if=audio.mic === "on">
        <span>mic <code>s</code></span>
        <progress max=1 value=audio.s title=audio.s.toFixed(2)/>
      </if>
      <else>
        <button
          disabled=audio.mic === "pending"
          onClick() {
            void mic.start();
          }
        >
          enable microphone (<code>s</code>)
        </button>
      </else>
    </if>
    <if=wants.m>
      <if=audio.music === "on">
        <span>computer audio <code>m</code></span>
        <progress max=1 value=audio.m title=audio.m.toFixed(2)/>
        <button onClick() {
          music.stop();
        }>
          stop sharing
        </button>
      </if>
      <else>
        <button
          disabled=audio.music === "pending"
          onClick() {
            void music.start();
          }
        >
          share computer audio (<code>m</code>)
        </button>
      </else>
    </if>
    <if=audio.err><code>${audio.err}</code></if>
  </p>
</if>

<div class=styles.hint>
  available functions:
  <ul>
    <li><code>t</code> = current frame</li>
    <li><code>s</code> = sound in room</li>
    <li><code>m</code> = music from computer</li>
    <li><code>sin(x)</code>, <code>cos(x)</code>, <code>tan(x)</code></li>
    <li><code>noise(value, type = perlin | white, seed = 0)</code></li>
    <li><code>+ - * / % ^ ( )</code></li>
  </ul>
</div>

<if=err>
  <p><code>${err}</code></p>
</if>

<home/>
