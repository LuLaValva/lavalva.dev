import { compile } from "./expr";
import { mic, music, type AudioState } from "./audio";
import { SPACES, type SpaceId } from "./spaces";
import {
  connect,
  disconnect,
  metronome,
  reconnect,
  rt,
  setBytes,
  supported,
} from "./lamp";
import styles from "./fireplace.module.css";

<let/ok=true>
<let/device=null as BluetoothDevice | null>
<let/on=true>
<let/err="">
<let/preview=[0, 0, 0, 0]>
<let/audio={
  mic: "off" as AudioState,
  music: "off" as AudioState,
  err: "",
  s: 0,
  m: 0,
}>

<let-search/space="rgbw" key="space"/>
<const/spaceId=(space in SPACES ? space : "rgbw") as SpaceId>

// White is a separate hardware channel shared by every space; the three
// color channels live in per-space <show> blocks below, which publish the
// active space's sources here.
<let-search/w=(SPACES.rgbw.presets[0].channels[3]) key="w"/>
<let/colorSrcs=(SPACES.rgbw.presets[0].channels.slice(0, 3))>

<script>ok = supported();</script>

<script>reconnect((d) => (device = d));</script>

<const/srcs=`${colorSrcs.join(" ")} ${w}`>
<const/wants={ s: /\bs\b/.test(srcs), m: /\bm\b/.test(srcs) }>

<script>
  rt.fns = [...colorSrcs, w].map((src) => {
    try {
      return compile(src);
    } catch {
      return null;
    }
  });
  rt.toCSS = SPACES[spaceId].css;
</script>

// The mic needs no gesture, so it follows usage automatically; screen-share
// audio for `m` must start from the button below. Both stop when unused.
<script>
  if (wants.s) void mic.start();
  else mic.stop();
</script>
<script>if (!wants.m) music.stop();</script>
<script>
  $signal.onabort = () => {
    mic.stop();
    music.stop();
  };
</script>

<script>
  $signal.onabort = metronome((rgbw) => {
    preview = rgbw;
    err = rt.err;
    audio = {
      mic: mic.state,
      music: music.state,
      err: mic.err || music.err,
      s: mic.value,
      m: music.value,
    };
  });
</script>

<h1>Fireplace</h1>

<if=!ok>
  <p>Web Bluetooth isn't available here (needs Chromium + HTTPS/localhost).</p>
</if>

<p class=styles.controls>
  <if=device>
    <span>Connected: ${device.name || device.id}</span>
    <button onClick() {
      disconnect(device!);
      device = null;
    }>
      Disconnect
    </button>
    <button onClick() {
      on = !on;
      rt.on = on;
      setBytes([[0, (on ? 4 : 3) << 4]]);
    }>
      ${on ? "Turn off" : "Turn on"}
    </button>
  </if>
  <else>
    <button
      disabled=!ok
      onClick() {
        connect((d) => (device = d)).catch(
          (e: unknown) => (rt.err = String(e)),
        );
      }
    >
      Connect
    </button>
    (the program below runs either way)
  </else>
</p>

<div class=styles.toolbar>
  <span
    class=styles.swatch
    title="rgb output"
    style=`background:rgb(${preview[0]},${preview[1]},${preview[2]})`
  />
  <span
    class=styles.swatch
    title="white output"
    style=`background:rgb(${preview[3]},${preview[3]},${preview[3]})`
  />
  <label>
    space:
    <select
      value=spaceId
      valueChange(v) {
        space = v;
      }
    >
      <for|[id, s]| of=Object.entries(SPACES)>
        <option value=id>${s.label}</option>
      </for>
    </select>
  </label>
</div>

<show=spaceId === "rgbw">
  <let-search/r=(SPACES.rgbw.presets[0].channels[0]) key="r" active=spaceId === "rgbw"/>
  <let-search/g=(SPACES.rgbw.presets[0].channels[1]) key="g" active=spaceId === "rgbw"/>
  <let-search/b=(SPACES.rgbw.presets[0].channels[2]) key="b" active=spaceId === "rgbw"/>
  <script>
    if (spaceId === "rgbw") colorSrcs = [r, g, b];
  </script>
  <div class=styles.fields>
    <preset-select
      presets=SPACES.rgbw.presets
      load(c) {
        [r, g, b, w] = c;
      }
    />
    <expr-input name="r" value:=r/>
    <expr-input name="g" value:=g/>
    <expr-input name="b" value:=b/>
    <expr-input name="w" value:=w/>
  </div>
</show>

<show=spaceId === "hslw">
  <let-search/h=(SPACES.hslw.presets[0].channels[0]) key="h" active=spaceId === "hslw"/>
  <let-search/sat=(SPACES.hslw.presets[0].channels[1]) key="s" active=spaceId === "hslw"/>
  <let-search/l=(SPACES.hslw.presets[0].channels[2]) key="l" active=spaceId === "hslw"/>
  <script>
    if (spaceId === "hslw") colorSrcs = [h, sat, l];
