import { compile } from "./expr";
import { PRESETS } from "./presets";
import {
  connect,
  disconnect,
  metronome,
  rt,
  setBytes,
  supported,
} from "./lamp";
import styles from "./fireplace.module.css";

<let/ok=true>
<let/device=null as BluetoothDevice | null>
<let/on=true>
<let/err="">
<let/preview=[0, 0, 0, 0]>

// The program is shareable and survives reload: every commit lands in
// ?r=…&g=…&b=…&w=….
<let-search/r=(PRESETS[0].channels[0]) key="r"/>
<let-search/g=(PRESETS[0].channels[1]) key="g"/>
<let-search/b=(PRESETS[0].channels[2]) key="b"/>
<let-search/w=(PRESETS[0].channels[3]) key="w"/>

<script>ok = supported();</script>

<script>
  rt.fns = [r, g, b, w].map((src) => {
    try {
      return compile(src);
    } catch {
      return null;
    }
  });
</script>

<script>
  $signal.onabort = metronome((rgbw) => {
    preview = rgbw;
    err = rt.err;
  });
</script>

<h1>Fireplace</h1>

<if=!ok>
  <p>Web Bluetooth isn't available here (needs Chromium + HTTPS/localhost).</p>
</if>

<p class=styles.controls>
  <if=device>
    <span>Connected: ${device.name || device.id}</span>
    <button onClick() {
      disconnect(device!);
      device = null;
    }>
      Disconnect
    </button>
    <button onClick() {
      on = !on;
      rt.on = on;
      setBytes([[0, (on ? 4 : 3) << 4]]);
    }>
      ${on ? "Turn off" : "Turn on"}
    </button>
  </if>
  <else>
    <button
      disabled=!ok
      onClick() {
        connect((d) => (device = d)).catch(
          (e: unknown) => (rt.err = String(e)),
        );
      }
    >
      Connect
    </button>
    (the program below runs either way)
  </else>
</p>

<div class=styles.toolbar>
  <span
    class=styles.swatch
    title="rgb output"
    style=`background:rgb(${preview[0]},${preview[1]},${preview[2]})`
  />
  <span
    class=styles.swatch
    title="white output"
    style=`background:rgb(${preview[3]},${preview[3]},${preview[3]})`
  />
  <label>
    preset:
    <select
      value=""
      valueChange(v) {
        const preset = PRESETS.find((p) => p.name === v);
        if (preset) [r, g, b, w] = preset.channels;
      }
    >
      <option value="" disabled>load…</option>
      <for|p| of=PRESETS>
        <option value=p.name>${p.name}</option>
      </for>
    </select>
  </label>
</div>

<div class=styles.fields>
  <expr-input name="r" value:=r/>
  <expr-input name="g" value:=g/>
  <expr-input name="b" value:=b/>
  <expr-input name="w" value:=w/>
</div>

<div class=styles.hint>
  available functions:
  <ul>
    <li><code>t</code> = current frame</li>
    <li><code>sin(x)</code>, <code>cos(x)</code>, <code>tan(x)</code></li>
    <li>
      <code>noise(value, type = perlin, seed = 0)</code> — type
      <code>perlin</code> or <code>white</code>
    </li>
    <li><code>+ - * / % ^ ( )</code></li>
  </ul>
</div>

<if=err>
  <p><code>${err}</code></p>
</if>

<home/>
