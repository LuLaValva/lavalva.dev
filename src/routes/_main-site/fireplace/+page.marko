import { compile } from "./expr";
import { mic, music, type AudioState } from "./audio";
import { SPACES, type SpaceId } from "./spaces";
import {
  connect,
  disconnect,
  metronome,
  reconnect,
  rt,
  setBytes,
  supported,
} from "./lamp";
import styles from "./fireplace.module.css";

<let/ok=true>
<let/device=null as BluetoothDevice | null>
<let/on=true>
<let/err="">
<let/preview=[0, 0, 0, 0]>
<let/audio={
  mic: "off" as AudioState,
  music: "off" as AudioState,
  err: "",
  s: 0,
  m: 0,
}>

<let-search/space="rgbw" key="space"/>
<const/spaceId=(space in SPACES ? space : "rgbw") as SpaceId>

// White is a separate hardware channel shared by every space; the three
// color channels live in the per-space <space-editor>s below, and
// colorSrcs picks the active editor's returned sources.
<let-search/w=(SPACES.rgbw.presets[0].channels[3]) key="w"/>

<script>ok = supported();</script>

<script>reconnect((d) => (device = d));</script>

<script>
  $signal.onabort = () => {
    mic.stop();
    music.stop();
  };
</script>

<script>
  $signal.onabort = metronome((rgbw) => {
    preview = rgbw;
    err = rt.err;
    audio = {
      mic: mic.state,
      music: music.state,
      err: mic.err || music.err,
      s: mic.value,
      m: music.value,
    };
  });
</script>

<h1>Fireplace</h1>

<if=!ok>
  <p>Web Bluetooth isn't available here (needs Chromium + HTTPS/localhost).</p>
</if>

<p class=styles.controls>
  <if=device>
    <span>Connected: ${device.name || device.id}</span>
    <button onClick() {
      disconnect(device!);
      device = null;
    }>
      Disconnect
    </button>
    <button onClick() {
      on = !on;
      rt.on = on;
      setBytes([[0, (on ? 4 : 3) << 4]]);
    }>
      ${on ? "Turn off" : "Turn on"}
    </button>
  </if>
  <else>
    <button
      disabled=!ok
      onClick() {
        connect((d) => (device = d)).catch(
          (e: unknown) => (rt.err = String(e)),
        );
      }
    >
      Connect
    </button>
    (the program below runs either way)
  </else>
</p>

<div class=styles.toolbar>
  <span
    class=styles.swatch
    title="rgb output"
    style=`background:rgb(${preview[0]},${preview[1]},${preview[2]})`
  />
  <span
    class=styles.swatch
    title="white output"
    style=`background:rgb(${preview[3]},${preview[3]},${preview[3]})`
  />
  <label>
    space:
    <select
      value=spaceId
      valueChange(v) {
        space = v;
      }
    >
      <for|[id, s]| of=Object.entries(SPACES)>
        <option value=id>${s.label}</option>
      </for>
    </select>
  </label>
</div>

<space-editor/rgbwC space=SPACES.rgbw active=spaceId === "rgbw" w:=w/>
// <space-editor/hslwC space=SPACES.hslw active=spaceId === "hslw" w:=w/>
// <space-editor/hwbC space=SPACES.hwb active=spaceId === "hwb" w:=w/>
<space-editor/oklchC space=SPACES.oklch active=spaceId === "oklch" w:=w/>
// <space-editor/oklabC space=SPACES.oklab active=spaceId === "oklab" w:=w/>
// <space-editor/lchC space=SPACES.lch active=spaceId === "lch" w:=w/>
// <space-editor/labC space=SPACES.lab active=spaceId === "lab" w:=w/>

<const/colorSrcs={
  rgbw: rgbwC,
  // hslw: hslwC,
  // hwb: hwbC,
  oklch: oklchC,
  // oklab: oklabC,
  // lch: lchC,
  // lab: labC,
}[spaceId]>


<const/srcs=`${colorSrcs.join(" ")} ${w}`>
<const/wants={ s: /\bs\b/.test(srcs), m: /\bm\b/.test(srcs) }>

<script>
  rt.fns = [...colorSrcs, w].map((src) => {
    try {
      return compile(src);
    } catch {
      return null;
    }
  });
  rt.toCSS = SPACES[spaceId].css;
</script>

// The mic needs no gesture, so it follows usage automatically; screen-share
// audio for `m` must start from the button below. Both stop when unused.
<script>
  if (wants.s) void mic.start();
  else mic.stop();
</script>
<script>if (!wants.m) music.stop();</script>

<if=wants.s || wants.m>
  <p class=styles.audio>
    <if=wants.s>
      <if=audio.mic === "on">
        <span>mic <code>s</code></span>
        <progress max=1 value=audio.s title=audio.s.toFixed(2)/>
      </if>
      <else>
        <button
          disabled=audio.mic === "pending"
          onClick() {
            void mic.start();
          }
        >
          enable microphone (<code>s</code>)
        </button>
      </else>
    </if>
    <if=wants.m>
      <if=audio.music === "on">
        <span>computer audio <code>m</code></span>
        <progress max=1 value=audio.m title=audio.m.toFixed(2)/>
        <button onClick() {
          music.stop();
        }>
          stop sharing
        </button>
      </if>
      <else>
        <button
          disabled=audio.music === "pending"
          onClick() {
            void music.start();
          }
        >
          share computer audio (<code>m</code>)
        </button>
      </else>
    </if>
    <if=audio.err><code>${audio.err}</code></if>
  </p>
</if>

<div class=styles.hint>
  available functions:
  <ul>
    <li><code>t</code> = current frame</li>
    <li><code>s</code> = sound in room</li>
    <li><code>m</code> = music from computer</li>
    <li><code>sin(x)</code>, <code>cos(x)</code>, <code>tan(x)</code></li>
    <li><code>noise(value, type = perlin | white, seed = 0)</code></li>
    <li><code>+ - * / % ^ ( )</code></li>
  </ul>
</div>

<if=err>
  <p><code>${err}</code></p>
</if>

<home/>
