    <expr-input name="wh" value:=hw/>
    <expr-input name="bl" value:=hb/>
    <expr-input name="w" value:=w/>
  </div>
</show>

<show=spaceId === "oklch">
  <let-search/okl=(SPACES.oklch.presets[0].channels[0]) key="okl" active=spaceId === "oklch"/>
  <let-search/okc=(SPACES.oklch.presets[0].channels[1]) key="okc" active=spaceId === "oklch"/>
  <let-search/okh=(SPACES.oklch.presets[0].channels[2]) key="okh" active=spaceId === "oklch"/>
