    <expr-input name="h" value:=h/>
    <expr-input name="s" value:=sat/>
    <expr-input name="l" value:=l/>
    <expr-input name="w" value:=w/>
  </div>
</show>

<show=spaceId === "hwb">
  <let-search/hh=(SPACES.hwb.presets[0].channels[0]) key="hh" active=spaceId === "hwb"/>
  <let-search/hw=(SPACES.hwb.presets[0].channels[1]) key="hw" active=spaceId === "hwb"/>
  <let-search/hb=(SPACES.hwb.presets[0].channels[2]) key="hb" active=spaceId === "hwb"/>
  <script>
    if (spaceId === "hwb") colorSrcs = [hh, hw, hb];
  </script>
  <div class=styles.fields>
