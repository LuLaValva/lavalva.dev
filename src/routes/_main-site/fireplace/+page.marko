import {
  attach,
  connectLamp,
  readState,
  supported,
  writeState,
  STATE_LEN,
} from "./ble";
import { evalGraph, freshMemory, type Graph } from "./flow";
import { PRESETS } from "./presets";
import styles from "./flow.module.css";

// The program is sampled every animation frame, but frames only stream to
// the lamp this often. writeWithoutResponse comfortably sustains this; the
// latest-wins queue below absorbs hiccups.
static const SEND_MS = 40;
static const SAVE_KEY = "fireplace-graph";

<let/ok=true>
<let/lamp=null as Awaited<ReturnType<typeof connectLamp>> | null>
<let/deviceName="">
<let/bytes=[] as number[]>
<let/err="">
<let/on=true>
<let/graph=PRESETS[0].graph as Graph>
<let/preview=[0, 0, 0, 0]>
<let/brightness=1>
<let/frame=0>

<script>
  ok = supported();
  const saved = localStorage.getItem(SAVE_KEY);
  if (saved) {
    try {
      graph = JSON.parse(saved) as Graph;
    } catch {}
  }
</script>

// GATT rejects overlapping operations, so writes are queued latest-wins: at
// most one in flight, and edits made meanwhile collapse into a single
// follow-up write of the newest bytes.
<const/inFlight={ busy: false, again: false }>

<const/send() {
  const l = lamp;
  if (!l || bytes.length !== STATE_LEN) return;
  if (inFlight.busy) {
    inFlight.again = true;
    return;
  }
  inFlight.busy = true;
  (async () => {
    do {
      inFlight.again = false;
      try {
        await writeState(l.char, bytes);
        err = "";
      } catch (e: unknown) {
        err = String(e);
      }
    } while (inFlight.again);
    inFlight.busy = false;
  })();
}>

<const/setBytes(edits: [number, number][]) {
  let next = bytes;
  for (const [i, v] of edits) next = next.toSpliced(i, 1, v);
  bytes = next;
  send();
}>

// The lamp's firmware modes are ignored: programs are sampled here and
// streamed as solid-color (mode 0) writes to color slot 1. Mode 3/4 is
// still used as the power toggle (PROTOCOL.md).
<const/setColor(r: number, g: number, b: number, w: number) {
  setBytes([
    [0, 0],
    [1, r],
    [2, g],
    [3, b],
    [4, w],
  ]);
}>

<const/clock={ t: 0, last: 0, sent: 0 }>
<const/mem=freshMemory()>

// The core event loop: Marko batches renders to animation frames, so a
// script that bumps its own dependency re-runs once per frame.
<script>frame++;</script>

// The interpreter runs every frame so the preview swatch stays smooth with
// no lamp nearby; a frame only streams out at most every SEND_MS, and only
// while connected and powered on. dt is clamped so a backgrounded tab
// (rAF stops) doesn't fast-forward the program on return.
<script>
  frame;
  const now = performance.now();
  const dt = Math.min(0.1, (now - clock.last) / 1000);
  clock.last = now;
  clock.t += dt;
  const rgbw = evalGraph(graph, { t: clock.t, dt }, mem).map((v) =>
    Math.round(v * 255),
  );
  preview = rgbw;
  if (lamp && on && now - clock.sent >= SEND_MS) {
    clock.sent = now;
    const [r, g, b, w] = rgbw;
    setColor(
      Math.round(r * brightness),
      Math.round(g * brightness),
      Math.round(b * brightness),
      Math.round(w * brightness),
    );
  }
</script>

// The lamp only allows one central at a time and drops connections freely,
// so hold it like a regular paired device: auto-reconnect until the user
// explicitly disconnects.
<const/wants={ connected: false }>

<const/onDisconnected(device: BluetoothDevice) {
  lamp = null;
  (async () => {
    for (let tries = 0; wants.connected && tries < 5; tries++) {
      try {
        const char = await attach(device);
        deviceName = device.name || device.id;
        bytes = await readState(char);
        lamp = { device, char };
        err = "";
        return;
      } catch (e: unknown) {
        err = `reconnecting… (${String(e)})`;
        await new Promise((r) => setTimeout(r, 1000 * (tries + 1)));
      }
    }
    if (wants.connected) {
      wants.connected = false;
      bytes = [];
    }
  })();
}>

<const/doConnect() {
  connectLamp()
    .then(async (l) => {
      wants.connected = true;
      l.device.addEventListener("gattserverdisconnected", () => {
        if (wants.connected) onDisconnected(l.device);
      });
      deviceName = l.device.name || l.device.id;
      bytes = await readState(l.char);
      lamp = l;
      err = "";
    })
    .catch((e: unknown) => (err = String(e)));
}>

<h1>Fireplace</h1>

<if=!ok>
  <p>Web Bluetooth isn't available here (needs Chromium + HTTPS/localhost).</p>
</if>

<p>
  <if=lamp && bytes.length === STATE_LEN>
    Connected: ${deviceName}
    <button onClick() {
      wants.connected = false;
      lamp?.device.gatt?.disconnect();
      lamp = null;
      bytes = [];
    }>
      Disconnect
    </button>
    <button onClick() {
      on = !on;
      setBytes([[0, (on ? 4 : 3) << 4]]);
    }>
      ${on ? "Turn off" : "Turn on"}
    </button>
  </if>
  <else>
    <button
      disabled=!ok
      onClick() {
        doConnect();
      }
    >
      Connect
    </button>
    (the editor below runs either way)
  </else>
</p>

<div class=styles.toolbar>
  <span
    class=styles.swatch
    title="live output"
    style=`background:rgb(${preview[0]},${preview[1]},${preview[2]})`
  />
  <label>
    brightness:
    <input
      type="range"
      min="0.05"
      max="1"
      step="0.05"
      value=String(brightness)
      valueChange(v) {
        brightness = +v;
      }
    >
  </label>
  <label>
    preset:
    <select
      value=""
      valueChange(v) {
        const preset = PRESETS.find((p) => p.name === v);
        if (preset) graph = preset.graph;
      }
    >
      <option value="" disabled>load…</option>
      <for|p| of=PRESETS>
        <option value=p.name>${p.name}</option>
      </for>
    </select>
  </label>
  <button onClick() {
    localStorage.setItem(SAVE_KEY, JSON.stringify(graph));
  }>
    Save
  </button>
  <button onClick() {
    // For promoting a saved program into presets.ts.
    navigator.clipboard.writeText(JSON.stringify(graph));
  }>
    Copy JSON
  </button>
</div>

<node-editor
  graph=graph
  graphChange(g: Graph) {
    graph = g;
  }
/>

<if=err>
  <p><code>${err}</code></p>
</if>

<home/>
