import { produce } from "immer"
import { TILE_BODY } from "../../../game/flip"
import styles from "../contact-styles.module.css"

export interface Input {
  size: number;
}

static declare global {
  namespace Marko {
    namespace CSS {
      interface Properties {
        "--size"?: number;
      }
    }
  }
}

// A hash rather than Math.random, so the server and client agree on the tilt.
static function tilt(i: number, j: number, flips: number) {
  const n = Math.sin(i * 78.233 + j * 37.719 + flips * 55.137) * 43758.5;
  return (n - Math.floor(n) - 0.5) * 4;
}

static const SKID_WORTH_A_HOP = 2;

const/{ size }=input

// How often each tile has been flipped (odd is face down), and from which
// neighbour the press that last flipped it came.
let/tiles=Array.from({ length: size }, () =>
  Array.from({ length: size }, () => ({ flips: 0, di: 0, dj: 0 })),
)

let/_focused=0
let/focused=_focused
  ,valueChange(v) {
    _focused = v;
    [...$cell][v].focus();
  }

div class=styles.grid style={ "--size": size }
  for|row, i| of=tiles
    for|{ flips, di, dj }, j| of=row
      button/$cell
        ,class=styles.cell
        ,tabindex=(i * size + j === focused ? 0 : -1)
        ,onFocus() {
          _focused = i * size + j;
        }
        ,onKeyDown(e) {
          const wrap = (n: number) => (n + size) % size;
          switch (e.key) {
            case "ArrowRight":
              focused = i * size + wrap(j + 1);
              break;
            case "ArrowLeft":
              focused = i * size + wrap(j - 1);
              break;
            case "ArrowDown":
              focused = wrap(i + 1) * size + j;
              break;
            case "ArrowUp":
              focused = wrap(i - 1) * size + j;
              break;
            case "Home":
              focused = e.ctrlKey ? 0 : i * size;
              break;
            case "End":
              focused = e.ctrlKey ? size * size - 1 : i * size + size - 1;
              break;
            default:
              return;
          }
          e.preventDefault();
        }
        ,onClick() {
          tiles = produce(tiles, (tiles) => {
            for (let di = -1; di <= 1; di++) {
              for (let dj = -1; dj <= 1; dj++) {
                if (di === 0 && dj === 0) continue;

                const tile = tiles[i + di]?.[j + dj];
                if (tile) {
                  tile.flips++;
                  tile.di = di;
                  tile.dj = dj;
                }
              }
            }
          })
        }
        ,aria-label=`${i} ${j}`
        ,aria-pressed=flips % 2 ? "true" : "false"
        // Keyed by the count, so every flip mounts a fresh tile to toss.
        for|n| of=[flips] by=String
          if=n
            span
              ,class=[
                styles.tile,
                styles.flipping,
                Math.abs(tilt(i, j, n) - tilt(i, j, n - 1)) > SKID_WORTH_A_HOP &&
                  styles.bounces,
                n % 2 ? styles.back : styles.fromBack,
              ]
              // Tipped away from the press, with the corners a beat behind.
              ,style=`--tilt:${tilt(i, j, n - 1)}deg; --tilt-after-flip:${tilt(i, j, n)}deg; --flip-axis:${-di}, ${dj}, 0; --flip-delay:${di && dj ? 60 : 0}ms`
              for|{ z, out, mix }| of=TILE_BODY
                span class=styles.slice style=`--z:${z}; --out:${out}; --mix:${mix}`
          else
            span
              ,class=[styles.tile, styles.faceUp]
              ,style=`--tilt:${tilt(i, j, 0)}deg`

return=BigInt("0b" + tiles.map(row => row.map(({ flips }) => flips % 2).join('')).join(''))
